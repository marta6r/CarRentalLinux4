@model CarRental.Models.Customer

@{
    ViewData["Title"] = "Редактирование клиента";
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
    }

    body {
        background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    body.dark-mode {
        background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
    }

    /* Шапка */
    .navbar-custom {
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.95), rgba(52, 152, 219, 0.95));
        backdrop-filter: blur(10px);
        padding: 1rem 0;
        margin-bottom: 2rem;
    }

    body.dark-mode .navbar-custom {
        background: linear-gradient(135deg, rgba(30, 43, 58, 0.95), rgba(44, 62, 80, 0.95));
    }

    /* Заголовок страницы */
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: #2ecc71;
    }

    /* Карточка формы */
    .form-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .form-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .card-header {
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        padding: 1.5rem 2rem;
        border: none;
    }

    .card-header h4 {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    /* Поля формы */
    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .form-label {
        color: #f8f9fa;
    }

    .form-label i {
        color: #2ecc71;
        font-size: 1.1rem;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid rgba(46, 204, 113, 0.2);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        color: #2c3e50;
        width: 100%;
    }

    body.dark-mode .form-control {
        background: rgba(60, 60, 60, 0.9);
        border-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .form-control:focus {
        border-color: #2ecc71;
        box-shadow: 0 0 0 0.25rem rgba(46, 204, 113, 0.25);
        background: white;
    }

    body.dark-mode .form-control:focus {
        background: rgba(80, 80, 80, 0.9);
        border-color: #2ecc71;
    }

    /* Плейсхолдер */
    .form-control::placeholder {
        color: #95a5a6;
        opacity: 0.7;
    }

    body.dark-mode .form-control::placeholder {
        color: #7f8c8d;
    }

    /* Подсказка */
    .form-text {
        color: #6c757d;
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .form-text {
        color: #adb5bd;
    }

    .form-text i {
        color: #2ecc71;
    }

    /* Секция для фото */
    .current-image {
        margin-top: 0.5rem;
        padding: 0.75rem;
        background: rgba(46, 204, 113, 0.05);
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .current-image img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #2ecc71;
    }

    .current-image .image-info {
        flex: 1;
    }

    .image-info small {
        color: #6c757d;
    }

    body.dark-mode .image-info small {
        color: #adb5bd;
    }

    /* Ошибки валидации */
    .text-danger {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .validation-summary-errors {
        background: rgba(231, 76, 60, 0.1);
        border-left: 4px solid #e74c3c;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    body.dark-mode .validation-summary-errors {
        background: rgba(231, 76, 60, 0.2);
    }

    /* Кнопки */
    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(46, 204, 113, 0.4);
        color: white;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(149, 165, 166, 0.4);
        color: white;
    }

    /* Иконки полей */
    .input-icon-wrapper {
        position: relative;
    }

    .input-icon-wrapper i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #2ecc71;
        z-index: 10;
    }

    .input-icon-wrapper .form-control {
        padding-left: 2.5rem;
    }

    /* Адаптивность */
    @* @media (max-width: 768px) {
        .page-header {
            padding: 1rem;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .d-md-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .me-md-2 {
            margin-right: 0 !important;
        }
        
        .current-image {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
    } *@
</style>

<!-- Основной контент -->
<div class="container">
    <!-- Заголовок страницы -->
    <div class="page-header">
        <h1>
            <i class="bi bi-pencil-square"></i> @ViewData["Title"]
        </h1>
    </div>

    <!-- Карточка формы -->
    <div class="form-card">
        <div class="card-header">
            <h4>
                <i class="bi bi-pencil-square"></i> Редактирование: @Model.FullName
            </h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">
                            <i class="bi bi-person-badge"></i> ФИО
                        </label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-person-circle"></i>
                            <input asp-for="FullName" class="form-control" placeholder="Иванов Иван Иванович" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Введите полное имя клиента
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope"></i> Email
                        </label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-envelope-fill"></i>
                            <input asp-for="Email" class="form-control" placeholder="ivan@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Введите действующий email
                        </small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">
                            <i class="bi bi-telephone"></i> Телефон
                        </label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-telephone-fill"></i>
                            <input asp-for="Phone" class="form-control" placeholder="+375291234567" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Например: +375291234567
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PassportNumber" class="form-label">
                            <i class="bi bi-card-text"></i> Номер паспорта
                        </label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-card-text"></i>
                            <input asp-for="PassportNumber" class="form-control" placeholder="AB1234567" />
                        </div>
                        <span asp-validation-for="PassportNumber" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> 9 символов: буквы и цифры
                        </small>
                    </div>
                </div>

                <!-- Поле для загрузки фото -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label asp-for="ImageFile" class="form-label">
                            <i class="bi bi-image"></i> Фото клиента
                        </label>
                        <input asp-for="ImageFile" class="form-control" type="file" accept="image/jpeg,image/png,image/gif,image/webp" />
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Поддерживаются форматы: JPG, JPEG, PNG, GIF, WEBP. Максимальный размер: 5MB. Оставьте пустым, чтобы не менять фото
                        </small>
                        
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="current-image">
                                <img src="@Model.ImagePath" alt="@Model.FullName" />
                                <div class="image-info">
                                    <small><i class="bi bi-check-circle-fill text-success"></i> Текущее фото</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-secondary me-md-2">
                        <i class="bi bi-arrow-left"></i> Назад к списку
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Сохранить изменения
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}