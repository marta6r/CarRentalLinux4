@model CarRental.Models.Customer

@{
    ViewData["Title"] = "Регистрация";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    /* Стили для модальных окон */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-container {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        width: 400px;
        max-width: 90%;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        animation: modalSlideIn 0.3s ease-out;
    }

    body.dark-mode .modal-container {
        background: rgba(45, 45, 45, 0.98);
    }

    @@keyframes modalSlideIn {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-header-custom {
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header-error {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
    }

    .modal-header-warning {
        background: linear-gradient(135deg, #f39c12, #e67e22);
    }

    .modal-title-custom {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: white;
        transition: transform 0.2s;
    }

    .modal-close:hover {
        transform: scale(1.1);
    }

    .modal-body-custom {
        padding: 1.5rem;
        text-align: center;
    }

    .modal-body-custom i {
        font-size: 3rem;
        margin-bottom: 0.5rem;
    }

    .modal-body-custom h4 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    body.dark-mode .modal-body-custom h4 {
        color: white;
    }

    .modal-body-custom p {
        color: #6c757d;
        margin-bottom: 0;
    }

    body.dark-mode .modal-body-custom p {
        color: #adb5bd;
    }

    .modal-footer-custom {
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: center;
        border-top: 1px solid #e9ecef;
    }

    body.dark-mode .modal-footer-custom {
        border-top: 1px solid #555;
    }

    .btn-modal {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        border: none;
        padding: 0.5rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-modal:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
    }

    /* Основные стили */
    .card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
    }
    
    body.dark-mode .card {
        background: rgba(45, 45, 45, 0.95);
    }
    
    .form-control:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
    }
    
    .input-group .btn-outline-secondary {
        border-left: none;
    }
    
    .input-group .form-control:focus + .btn-outline-secondary {
        border-color: #3498db;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #3498db, #2980b9);
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(52, 152, 219, 0.4);
    }
    
    input[type="file"] {
        cursor: pointer;
    }
    
    input[type="file"]:hover {
        background-color: #f8f9fa;
    }
    
    #photoPreview {
        transition: transform 0.3s ease;
    }
    
    #photoPreview:hover {
        transform: scale(1.05);
    }
    
    @@media (max-width: 576px) {
        .card-body {
            padding: 1.5rem !important;
        }
    }
</style>

<div class="container" style="max-width: 600px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus" style="font-size: 3rem; color: #3498db;"></i>
                <h2 class="mt-2">Регистрация</h2>
            </div>
            
            <form method="post" autocomplete="off" enctype="multipart/form-data" id="registerForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <div class="mb-3">
                    <label class="form-label">ФИО</label>
                    <input asp-for="FullName" class="form-control" 
                           autocomplete="off" 
                           autocorrect="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" 
                           autocomplete="off" 
                           autocorrect="off" 
                           autocapitalize="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Телефон</label>
                    <input asp-for="Phone" class="form-control" 
                           placeholder="+375XXXXXXXXX" 
                           autocomplete="off" 
                           autocorrect="off" 
                           autocapitalize="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Номер паспорта</label>
                    <input asp-for="PassportNumber" class="form-control" 
                           placeholder="AB1234567" 
                           autocomplete="off" 
                           autocorrect="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="PassportNumber" class="text-danger"></span>
                </div>
                
                <!-- Поле для пароля -->
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" 
                               id="password" 
                               placeholder="Минимум 6 символов" 
                               autocomplete="new-password" 
                               required />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('password')">
                            <i class="bi bi-eye-slash" id="passwordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small class="text-muted">Пароль должен содержать минимум 6 символов</small>
                </div>
                
                <!-- Поле для подтверждения пароля -->
                <div class="mb-3">
                    <label class="form-label">Подтверждение пароля</label>
                    <div class="input-group">
                        <input type="password" name="ConfirmPassword" id="confirmPassword" 
                               class="form-control" 
                               placeholder="Повторите пароль" 
                               autocomplete="off" 
                               required />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('confirmPassword')">
                            <i class="bi bi-eye-slash" id="confirmPasswordIcon"></i>
                        </button>
                    </div>
                    <span class="text-danger" id="passwordMismatchError"></span>
                </div>
                
                <!-- Блок для загрузки фото клиента -->
                <div class="mb-4">
                    <label class="form-label">Фото клиента</label>
                    <div class="text-center mb-3" id="photoPreviewContainer" style="display: none;">
                        <img id="photoPreview" src="#" alt="Предпросмотр фото" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; border: 3px solid #3498db; padding: 3px;" />
                    </div>
                    <input type="file" name="CustomerPhoto" id="CustomerPhoto" 
                           class="form-control" 
                           accept="image/jpeg,image/png,image/jpg,image/gif"
                           style="padding: 8px;" />
                    <small class="text-muted">Поддерживаемые форматы: JPEG, PNG, JPG, GIF. Максимальный размер: 5MB</small>
                    <span id="photoError" class="text-danger" style="display: none;"></span>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill">
                    <i class="bi bi-check-lg"></i> Зарегистрироваться
                </button>
            </form>
            
            <p class="text-center mt-3">
                Уже есть аккаунт? <a href="/Account/Login">Войти</a>
            </p>
        </div>
    </div>
</div>

<!-- Модальное окно для ошибки "Пароли не совпадают" -->
<div id="passwordMismatchModal" class="modal-overlay" style="display: none;">
    <div class="modal-container">
        <div class="modal-header-custom modal-header-error">
            <h5 class="modal-title-custom">
                <i class="bi bi-exclamation-triangle-fill"></i> Ошибка валидации
            </h5>
            <button class="modal-close" onclick="closePasswordMismatchModal()">&times;</button>
        </div>
        <div class="modal-body-custom">
            <i class="bi bi-x-circle-fill" style="color: #e74c3c;"></i>
            <h4>Пароли не совпадают</h4>
            <p>Введённые пароли не совпадают. Пожалуйста, проверьте и повторите ввод.</p>
        </div>
        <div class="modal-footer-custom">
            <button type="button" class="btn-modal" onclick="closePasswordMismatchModal()">Понятно</button>
        </div>
    </div>
</div>

<!-- Модальное окно для ошибки "Пароль слишком короткий" -->
<div id="passwordLengthModal" class="modal-overlay" style="display: none;">
    <div class="modal-container">
        <div class="modal-header-custom modal-header-warning">
            <h5 class="modal-title-custom">
                <i class="bi bi-info-circle-fill"></i> Внимание
            </h5>
            <button class="modal-close" onclick="closePasswordLengthModal()">&times;</button>
        </div>
        <div class="modal-body-custom">
            <i class="bi bi-key-fill" style="color: #f39c12;"></i>
            <h4>Пароль слишком короткий</h4>
            <p>Пароль должен содержать <strong>минимум 6 символов</strong>. Пожалуйста, введите более надёжный пароль.</p>
        </div>
        <div class="modal-footer-custom">
            <button type="button" class="btn-modal" onclick="closePasswordLengthModal()">Понятно</button>
        </div>
    </div>
</div>

<script>
    // Функция для показа/скрытия пароля
    function togglePassword(fieldId) {
        const field = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + 'Icon');
        
        if (field.type === 'password') {
            field.type = 'text';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        } else {
            field.type = 'password';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        }
    }
    
    // Функции для модальных окон
    function showPasswordMismatchModal() {
        document.getElementById('passwordMismatchModal').style.display = 'flex';
    }
    
    function closePasswordMismatchModal() {
        document.getElementById('passwordMismatchModal').style.display = 'none';
    }
    
    function showPasswordLengthModal() {
        document.getElementById('passwordLengthModal').style.display = 'flex';
    }
    
    function closePasswordLengthModal() {
        document.getElementById('passwordLengthModal').style.display = 'none';
    }
    
    // Предпросмотр фото перед загрузкой
    document.getElementById('CustomerPhoto').addEventListener('change', function(event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById('photoPreviewContainer');
        const preview = document.getElementById('photoPreview');
        const photoError = document.getElementById('photoError');
        
        photoError.style.display = 'none';
        
        if (file) {
            const maxSize = 5 * 1024 * 1024;
            if (file.size > maxSize) {
                photoError.textContent = 'Размер файла не должен превышать 5MB';
                photoError.style.display = 'block';
                event.target.value = '';
                previewContainer.style.display = 'none';
                preview.src = '#';
                return;
            }
            
            const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                photoError.textContent = 'Поддерживаются только изображения (JPEG, PNG, JPG, GIF)';
                photoError.style.display = 'block';
                event.target.value = '';
                previewContainer.style.display = 'none';
                preview.src = '#';
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.style.display = 'none';
            preview.src = '#';
        }
    });
    
    // Валидация формы перед отправкой с красивыми модальными окнами
    document.getElementById('registerForm').addEventListener('submit', function(e) {
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        
        if (password !== confirmPassword) {
            e.preventDefault();
            showPasswordMismatchModal();
            return false;
        }
        
        if (password.length < 6) {
            e.preventDefault();
            showPasswordLengthModal();
            return false;
        }
        
        return true;
    });
    
    // Закрытие модальных окон по клику на фон
    document.getElementById('passwordMismatchModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closePasswordMismatchModal();
        }
    });
    
    document.getElementById('passwordLengthModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closePasswordLengthModal();
        }
    });
    
    // Закрытие по Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (document.getElementById('passwordMismatchModal').style.display === 'flex') {
                closePasswordMismatchModal();
            }
            if (document.getElementById('passwordLengthModal').style.display === 'flex') {
                closePasswordLengthModal();
            }
        }
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}