@model CarRental.Models.Rental
@{
    ViewData["Title"] = "Добавление аренды";
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
    }

    body {
        @* background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
        *@
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    body.dark-mode {
        @* background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
     *@
    }

    /* Шапка */
    .navbar-custom {
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.95), rgba(52, 152, 219, 0.95));
        backdrop-filter: blur(10px);
        padding: 1rem 0;
        margin-bottom: 2rem;
    }

    body.dark-mode .navbar-custom {
        background: linear-gradient(135deg, rgba(30, 43, 58, 0.95), rgba(44, 62, 80, 0.95));
    }

    /* Заголовок страницы */
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: #f1c40f;
    }

    /* Карточка формы */
    .form-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .form-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .card-header {
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        padding: 1.5rem 2rem;
        border: none;
    }

    .card-header h4 {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    /* Поля формы */
    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .form-label {
        color: #f8f9fa;
    }

    .form-label i {
        color: #f1c40f;
        font-size: 1.1rem;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid rgba(241, 196, 15, 0.2);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        color: #2c3e50;
        width: 100%;
    }

    body.dark-mode .form-control {
        background: rgba(60, 60, 60, 0.9);
        border-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .form-control:focus {
        border-color: #f1c40f;
        box-shadow: 0 0 0 0.25rem rgba(241, 196, 15, 0.25);
        background: white;
    }

    body.dark-mode .form-control:focus {
        background: rgba(80, 80, 80, 0.9);
        border-color: #f1c40f;
    }

    .form-control[readonly] {
        background: rgba(241, 196, 15, 0.05);
        border-color: rgba(241, 196, 15, 0.2);
        cursor: default;
    }

    body.dark-mode .form-control[readonly] {
        background: rgba(241, 196, 15, 0.1);
    }

    /* Плейсхолдер */
    .form-control::placeholder {
        color: #95a5a6;
        opacity: 0.7;
    }

    body.dark-mode .form-control::placeholder {
        color: #7f8c8d;
    }

    /* Подсказка */
    .form-text {
        color: #6c757d;
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .form-text {
        color: #adb5bd;
    }

    .form-text i {
        color: #f1c40f;
    }

    /* Информационные блоки */
    .alert-info {
        background: rgba(241, 196, 15, 0.1);
        border-left: 4px solid #f1c40f;
        color: #2c3e50;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 0.5rem;
        font-size: 0.9rem;
    }

    body.dark-mode .alert-info {
        background: rgba(241, 196, 15, 0.15);
        color: #f8f9fa;
    }

    .alert-info strong {
        color: #f39c12;
    }

    /* Ошибки валидации */
    .text-danger {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .validation-summary-errors {
        background: rgba(231, 76, 60, 0.1);
        border-left: 4px solid #e74c3c;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    body.dark-mode .validation-summary-errors {
        background: rgba(231, 76, 60, 0.2);
    }

    #availabilityError {
        background: rgba(231, 76, 60, 0.1);
        border-left: 4px solid #e74c3c;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-top: 0.5rem;
        font-weight: 500;
    }

    /* Расчет стоимости */
    #calculationInfo {
        background: rgba(241, 196, 15, 0.05);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
        color: #f39c12;
    }

    body.dark-mode #calculationInfo {
        background: rgba(241, 196, 15, 0.1);
    }

    /* Кнопки */
    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(241, 196, 15, 0.4);
        color: white;
    }

    .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(149, 165, 166, 0.4);
        color: white;
    }

    /* Стили для autocomplete */
    .ui-autocomplete {
        position: absolute;
        z-index: 9999 !important;
        cursor: default;
        padding: 0.5rem 0;
        margin-top: 0.25rem;
        list-style: none;
        background: white;
        border: 2px solid rgba(241, 196, 15, 0.2);
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        max-height: 250px;
        overflow-y: auto;
    }

    body.dark-mode .ui-autocomplete {
        background: #2d2d2d;
        border-color: rgba(241, 196, 15, 0.3);
        color: #f8f9fa;
    }

    .ui-autocomplete > li {
        padding: 0.75rem 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .ui-autocomplete > li:hover {
        background: rgba(241, 196, 15, 0.1);
    }

    body.dark-mode .ui-autocomplete > li:hover {
        background: rgba(241, 196, 15, 0.2);
    }

    .ui-helper-hidden-accessible {
        display: none;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1rem;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .d-md-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .me-md-2 {
            margin-right: 0 !important;
        }
    }
</style>

<!-- Основной контент -->
<div class="container">
    <!-- Заголовок страницы -->
    <div class="page-header">
        <h1>
            <i class="bi bi-plus-circle"></i> @ViewData["Title"]
        </h1>
    </div>

    <!-- Карточка формы -->
    <div class="form-card">
        <div class="card-header">
            <h4>
                <i class="bi bi-file-earmark-text"></i> Оформление новой аренды
            </h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" id="rentalForm">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-car-front"></i> Автомобиль
                        </label>
                        <input type="text" id="carSearch" class="form-control" 
                               placeholder="Начните вводить марку или модель" 
                               autocomplete="off" />
                        <input type="hidden" asp-for="CarId" id="carId" />
                        <div id="carInfo" class="alert-info mt-2" style="display: none;"></div>
                        <span asp-validation-for="CarId" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Начните вводить марку или модель автомобиля
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-person-circle"></i> Клиент
                        </label>
                        <input type="text" id="customerSearch" class="form-control" 
                               placeholder="Начните вводить ФИО клиента" 
                               autocomplete="off" />
                        <input type="hidden" asp-for="CustomerId" id="customerId" />
                        <div id="customerInfo" class="alert-info mt-2" style="display: none;"></div>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Начните вводить ФИО клиента
                        </small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="RentDate" class="form-label">
                            <i class="bi bi-calendar-start"></i> Дата начала
                        </label>
                        <input asp-for="RentDate" type="date" class="form-control" id="rentDate"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="RentDate" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Минимальная дата - сегодня
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReturnDate" class="form-label">
                            <i class="bi bi-calendar-end"></i> Дата возврата
                        </label>
                        <input asp-for="ReturnDate" type="date" class="form-control" id="returnDate"
                               min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ReturnDate" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Должна быть позже даты начала
                        </small>
                        <div id="availabilityError" class="text-danger mt-2" style="display: none;"></div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="TotalPrice" class="form-label">
                            <i class="bi bi-currency-exchange"></i> Стоимость аренды (BYN)
                        </label>
                        <input asp-for="TotalPrice" class="form-control" id="totalPrice" readonly />
                        <span asp-validation-for="TotalPrice" class="text-danger"></span>
                        <div class="form-text" id="calculationInfo"></div>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-secondary me-md-2">
                        <i class="bi bi-arrow-left"></i> Назад к списку
                    </a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="bi bi-save"></i> Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.1/themes/base/jquery-ui.min.css">
}

@section Scripts {
    <!-- Сначала jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Потом jQuery UI -->
    <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.min.js"></script>
    <!-- Потом валидация -->
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            console.log("jQuery загружен и готов к работе!");
            
            let carDailyPrice = 0;

            // Проверка работы AJAX при загрузке страницы
            $.ajax({
                url: '/Rentals/SearchCars',
                data: { term: 'a' },
                success: function(data) {
                    console.log('✅ AJAX работает! Найдено автомобилей:', data.length);
                },
                error: function(xhr, status, error) {
                    console.error('❌ Ошибка AJAX:', status, error);
                }
            });

            // Автодополнение для автомобилей
            $("#carSearch").autocomplete({
                source: function(request, response) {
                    console.log('🔍 Поиск автомобилей: "' + request.term + '"');
                    
                    $.ajax({
                        url: '/Rentals/SearchCars',
                        dataType: 'json',
                        data: { term: request.term },
                        success: function(data) {
                            console.log('📦 Найдено автомобилей:', data.length, data);
                            
                            if (data && data.length > 0) {
                                response($.map(data, function(item) {
                                    return {
                                        label: item.text,
                                        value: item.text,
                                        id: item.id,
                                        price: item.dailyPrice,
                                        brand: item.brand,
                                        model: item.model,
                                        year: item.year
                                    };
                                }));
                            } else {
                                response([]);
                                $('#carInfo').html('<i class="bi bi-exclamation-circle"></i> Ничего не найдено').show();
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('❌ Ошибка поиска автомобилей:', error);
                            $('#carInfo').html('<i class="bi bi-exclamation-triangle"></i> Ошибка при поиске').show();
                        }
                    });
                },
                minLength: 1,
                select: function(event, ui) {
                    console.log('✅ Выбран автомобиль:', ui.item);
                    
                    $("#carId").val(ui.item.id);
                    carDailyPrice = ui.item.price;
                    $("#carSearch").val(ui.item.label);
                    $("#carInfo").html(`
                        <strong><i class="bi bi-check-circle-fill"></i> Выбран:</strong> ${ui.item.brand} ${ui.item.model} (${ui.item.year})<br>
                        <strong>Цена:</strong> ${ui.item.price} BYN/день
                    `).show();
                    
                    calculateTotalPrice();
                    checkCarAvailability();
                    return false;
                }
            });

            // Автодополнение для клиентов
            $("#customerSearch").autocomplete({
                source: function(request, response) {
                    console.log('🔍 Поиск клиентов: "' + request.term + '"');
                    
                    $.ajax({
                        url: '/Rentals/SearchCustomers',
                        dataType: 'json',
                        data: { term: request.term },
                        success: function(data) {
                            console.log('📦 Найдено клиентов:', data.length, data);
                            
                            if (data && data.length > 0) {
                                response($.map(data, function(item) {
                                    return {
                                        label: item.text,
                                        value: item.text,
                                        id: item.id
                                    };
                                }));
                            } else {
                                response([]);
                                $('#customerInfo').html('<i class="bi bi-exclamation-circle"></i> Ничего не найдено').show();
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('❌ Ошибка поиска клиентов:', error);
                            $('#customerInfo').html('<i class="bi bi-exclamation-triangle"></i> Ошибка при поиске').show();
                        }
                    });
                },
                minLength: 1,
                select: function(event, ui) {
                    console.log('✅ Выбран клиент:', ui.item);
                    
                    $("#customerId").val(ui.item.id);
                    $("#customerSearch").val(ui.item.label);
                    $("#customerInfo").html(`
                        <strong><i class="bi bi-check-circle-fill"></i> Выбран:</strong> ${ui.item.label}
                    `).show();
                    return false;
                }
            });

            // Расчет стоимости при изменении дат
            $("#rentDate, #returnDate").on('change', function() {
                calculateTotalPrice();
                checkCarAvailability();
            });

            // Функция расчета стоимости
            function calculateTotalPrice() {
                const rentDate = new Date($("#rentDate").val());
                const returnDate = new Date($("#returnDate").val());

                if (!rentDate || !returnDate || returnDate <= rentDate || carDailyPrice <= 0) {
                    $("#totalPrice").val("0");
                    $("#calculationInfo").html('<i class="bi bi-info-circle"></i> Выберите автомобиль и корректные даты');
                    return;
                }

                // Вычисляем количество дней
                const timeDiff = returnDate - rentDate;
                const daysDiff = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));

                // Рассчитываем и округляем стоимость
                const totalPrice = Math.round(daysDiff * carDailyPrice);

                // Обновляем поля
                $("#totalPrice").val(totalPrice);
                $("#calculationInfo").html(
                    `<i class="bi bi-calculator"></i> ${carDailyPrice} BYN × ${daysDiff} дн. = <strong>${totalPrice} BYN</strong>`
                );
            }

            // Функция проверки доступности автомобиля
            function checkCarAvailability() {
                const carId = $("#carId").val();
                const rentDate = $("#rentDate").val();
                const returnDate = $("#returnDate").val();

                if (!carId || !rentDate || !returnDate) return;

                $.ajax({
                    url: '/Rentals/CheckCarAvailability',
                    data: {
                        carId: carId,
                        rentDate: rentDate,
                        returnDate: returnDate
                    },
                    success: function(isAvailable) {
                        console.log('🔍 Проверка доступности:', isAvailable);
                        
                        if (!isAvailable) {
                            $("#availabilityError").html(`
                                <i class="bi bi-exclamation-triangle-fill"></i> 
                                Этот автомобиль уже арендован на выбранные даты
                            `).show();
                            $("#submitBtn").prop("disabled", true);
                        } else {
                            $("#availabilityError").hide();
                            $("#submitBtn").prop("disabled", false);
                        }
                    }
                });
            }

            // Проверка перед отправкой формы
            $("#rentalForm").on('submit', function(e) {
                if (!$("#carId").val()) {
                    alert("Пожалуйста, выберите автомобиль из списка");
                    e.preventDefault();
                    return false;
                }
                
                if (!$("#customerId").val()) {
                    alert("Пожалуйста, выберите клиента из списка");
                    e.preventDefault();
                    return false;
                }

                if ($("#availabilityError").is(":visible")) {
                    e.preventDefault();
                    alert("Нельзя сохранить аренду - автомобиль уже занят на выбранные даты");
                    return false;
                }
                
                return true;
            });

            // Очистка поля при потере фокуса, если ничего не выбрано
            $("#carSearch").on('blur', function() {
                if (!$("#carId").val()) {
                    $(this).val('');
                    $("#carInfo").hide();
                }
            });

            $("#customerSearch").on('blur', function() {
                if (!$("#customerId").val()) {
                    $(this).val('');
                    $("#customerInfo").hide();
                }
            });
        });
    </script>
}