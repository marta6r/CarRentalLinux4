@* @model List<CarRental.Models.CarStats>
@{
    ViewData["Title"] = "Статистика по автомобилям";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-car-front me-2"></i>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form method="get" class="mb-4">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">Количество:</label>
                        <select name="top" class="form-select" onchange="this.form.submit()">
                            <option value="5" selected="@(ViewBag.TopCount == 5)">Топ 5</option>
                            <option value="10" selected="@(ViewBag.TopCount == 10)">Топ 10</option>
                            <option value="20" selected="@(ViewBag.TopCount == 20)">Топ 20</option>
                            <option value="50" selected="@(ViewBag.TopCount == 50)">Топ 50</option>
                            <option value="0" selected="@(ViewBag.TopCount == 0)">Все автомобили</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Сортировка:</label>
                        <select name="sortBy" class="form-select" onchange="this.form.submit()">
                            <option value="count" selected="@(ViewBag.SortBy == "count" ? "selected" : null)">По количеству</option>
                            <option value="revenue" selected="@(ViewBag.SortBy == "revenue" ? "selected" : null)">По доходу</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-success me-2" id="downloadCsvBtn">
                            <i class="bi bi-file-earmark-excel me-2"></i>CSV
                        </button>
                        <button class="btn btn-danger" id="downloadPdfBtn">
                            <i class="bi bi-file-earmark-pdf me-2"></i>PDF
                        </button>
                    </div>
                </div>
            </form>

            <div class="chart-container mb-4" style="position: relative; height:400px; width:100%">
                <canvas id="statsChart"></canvas>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover" id="statsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Автомобиль</th>
                            <th>Аренды</th>
                            <th>Доход (BYN)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var car = Model[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@car.CarInfo</td>
                                <td>@car.RentalCount</td>
                                <td>@car.TotalRevenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Подключаем библиотеки -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.19.3/package/dist/xlsx.full.min.js"></script>

    <script>
        // Инициализация после загрузки страницы
        document.addEventListener('DOMContentLoaded', function() {
            initChart();
            setupDownloadButtons();
        });

        // Инициализация графика
        function initChart() {
            const ctx = document.getElementById('statsChart');
            if (!ctx) return;

            const carNames = @Html.Raw(Json.Serialize(Model.Select(c => c.CarInfo)));
            const rentalCounts = @Html.Raw(Json.Serialize(Model.Select(c => c.RentalCount)));
            const revenues = @Html.Raw(Json.Serialize(Model.Select(c => c.TotalRevenue)));

            // Цвета для графика
            const backgroundColors = [];
            for (let i = 0; i < carNames.length; i++) {
                const hue = (i * 360 / carNames.length) % 360;
                backgroundColors.push(`hsla(${hue}, 70%, 50%, 0.7)`);
            }

            new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: carNames,
                    datasets: [{
                        label: 'Количество аренд',
                        data: rentalCounts,
                        backgroundColor: backgroundColors,
                        borderColor: backgroundColors.map(c => c.replace('0.7', '1')),
                        borderWidth: 1
                    }, {
                        label: 'Доход (BYN)',
                        data: revenues,
                        backgroundColor: backgroundColors.map(c => c.replace('0.7', '0.4')),
                        borderColor: backgroundColors.map(c => c.replace('0.7', '1')),
                        borderWidth: 1,
                        type: 'line',
                        yAxisID: 'y-axis-1'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Количество аренд'
                            }
                        },
                        'y-axis-1': {
                            position: 'right',
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Доход (BYN)'
                            },
                            grid: {
                                drawOnChartArea: false
                            }
                        }
                    }
                }
            });
        }

        // Настройка кнопок скачивания
        function setupDownloadButtons() {
            document.getElementById('downloadCsvBtn').addEventListener('click', downloadCsv);
            document.getElementById('downloadPdfBtn').addEventListener('click', downloadPdf);
        }

        // Скачать CSV
        function downloadCsv() {
            try {
                const rows = Array.from(document.querySelectorAll('#statsTable tbody tr'));
                const csvContent = [
                    ['№', 'Автомобиль', 'Аренды', 'Доход (BYN)'],
                    ...rows.map(row => {
                        const cols = row.querySelectorAll('td');
                        return [
                            cols[0].textContent,
                            cols[1].textContent,
                            cols[2].textContent,
                            cols[3].textContent
                        ];
                    })
                ].map(e => e.join(',')).join('\n');

                const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `car_stats_${new Date().toISOString().slice(0,10)}.csv`;
                link.click();
            } catch (error) {
                console.error('CSV export error:', error);
                alert('Ошибка при создании CSV файла');
            }
        }

        // Скачать PDF
        function downloadPdf() {
            try {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();

                // Заголовок
                doc.setFontSize(18);
                doc.text('Статистика автомобилей', 14, 15);
                doc.setFontSize(12);
                doc.text(`Дата: ${new Date().toLocaleDateString('ru-RU')}`, 14, 22);

                // Таблица
                doc.autoTable({
                    head: [['№', 'Автомобиль', 'Аренды', 'Доход (BYN)']],
                    body: Array.from(document.querySelectorAll('#statsTable tbody tr')).map(row => {
                        const cols = row.querySelectorAll('td');
                        return [cols[0].textContent, cols[1].textContent, cols[2].textContent, cols[3].textContent];
                    }),
                    startY: 30,
                    styles: {
                        fontSize: 10,
                        cellPadding: 3
                    },
                    headStyles: {
                        fillColor: [52, 58, 64],
                        textColor: 255,
                        fontStyle: 'bold'
                    }
                });

                doc.save(`car_stats_${new Date().toISOString().slice(0,10)}.pdf`);
            } catch (error) {
                console.error('PDF export error:', error);
                alert('Ошибка при создании PDF файла');
            }
        }
    </script>
} *@



















@model List<CarRental.Models.CarStats>
@{
    ViewData["Title"] = "Статистика по автомобилям";
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
        --primary-blue: #3498db;
        --primary-dark-blue: #2980b9;
        --primary-purple: #9b59b6;
    }

    body {
        @* background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
        *@
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    body.dark-mode {
        @* background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
     *@
    } 
    /* Шапка */
    .navbar-custom {
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.95), rgba(52, 152, 219, 0.95));
        backdrop-filter: blur(10px);
        padding: 1rem 0;
        margin-bottom: 2rem;
    }

    body.dark-mode .navbar-custom {
        background: linear-gradient(135deg, rgba(30, 43, 58, 0.95), rgba(44, 62, 80, 0.95));
    }

    /* Заголовок страницы */
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: var(--primary-purple);
    }

    /* Карточка статистики */
    .stats-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .stats-card {
        background: rgba(45, 45, 45, 0.95);
    }

