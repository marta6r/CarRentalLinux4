                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Удалить">
                            <i class="bi bi-trash-fill"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Пустое состояние -->
        <div class="empty-state">
            <i class="bi bi-file-earmark-text"></i>
            <h3>Аренды не найдены</h3>
            <p>Создайте новую аренду, чтобы начать работу</p>
            <a asp-action="Create" class="btn-add">
                <i class="bi bi-plus-lg"></i> Новая аренда
            </a>
        </div>
    }
</div>