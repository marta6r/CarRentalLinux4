@model List<CarRental.Models.CarStats>

@{
    ViewData["Title"] = "Статистика по автомобилям";
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
        --primary-blue: #3498db;
        --primary-dark-blue: #2980b9;
        --primary-purple: #9b59b6;
    }

    body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        transition: all 0.3s ease;
    }

    body.dark-mode {
        background-color: #1a1a2e;
    }

    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: var(--primary-purple);
    }

    .stats-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }

    body.dark-mode .stats-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .card-header {
        background: linear-gradient(135deg, var(--primary-purple), #8e44ad);
        padding: 1.5rem 2rem;
        border: none;
    }

    .card-header h4 {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    .filters-section {
        background: rgba(155, 89, 182, 0.05);
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .filters-section {
        background: rgba(255, 255, 255, 0.03);
    }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .form-label {
        color: #f8f9fa;
    }

    .form-label i {
        color: var(--primary-purple);
        font-size: 1.1rem;
    }

    .form-select {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid rgba(155, 89, 182, 0.2);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        color: #2c3e50;
        cursor: pointer;
        width: 100%;
    }

    body.dark-mode .form-select {
        background: rgba(60, 60, 60, 0.9);
        border-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .form-select:focus {
        border-color: var(--primary-purple);
        box-shadow: 0 0 0 0.25rem rgba(155, 89, 182, 0.25);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        cursor: pointer;
    }

    .btn-success {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        color: white;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(46, 204, 113, 0.4);
        color: white;
    }

    .btn-danger {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: white;
    }

    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(231, 76, 60, 0.4);
        color: white;
    }

    .btn i {
        font-size: 1rem;
    }

    .chart-container {
        background: rgba(255, 255, 255, 0.8);
        border-radius: 15px;
        padding: 1rem;
        margin-bottom: 2rem;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        height: 400px;
        transition: all 0.3s ease;
    }

    body.dark-mode .chart-container {
        background: rgba(60, 60, 60, 0.8);
    }

    .table-container {
        overflow-x: auto;
    }

    .table {
        margin-bottom: 0;
        border-radius: 15px;
        overflow: hidden;
        width: 100%;
        border-collapse: collapse;
    }

    .table thead th {
        background: linear-gradient(135deg, var(--primary-purple), #8e44ad);
        color: white;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        border: none;
        padding: 1rem;
    }

    body.dark-mode .table thead th {
        background: linear-gradient(135deg, #8e44ad, #6c3483);
    }

    .table tbody tr {
        transition: all 0.3s ease;
    }

    .table tbody tr:hover {
        background-color: rgba(155, 89, 182, 0.1);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    body.dark-mode .table tbody tr:hover {
        background-color: rgba(155, 89, 182, 0.2);
    }

    .table td {
        padding: 1rem;
        vertical-align: middle;
        color: #2c3e50;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

    body.dark-mode .table td {
        color: #f8f9fa;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .rank-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        background: rgba(155, 89, 182, 0.1);
        color: var(--primary-purple);
        border-radius: 50%;
        font-weight: 700;
        transition: all 0.3s ease;
    }

    body.dark-mode .rank-badge {
        background: rgba(155, 89, 182, 0.2);
        color: #f8f9fa;
    }

    .car-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .car-info i {
        color: var(--primary-purple);
    }

    .stat-highlight {
        font-weight: 700;
        color: var(--primary-purple);
    }

    .revenue-highlight {
        font-weight: 700;
        color: #27ae60;
    }

    body.dark-mode .revenue-highlight {
        color: #2ecc71;
    }

    .text-center {
        text-align: center;
    }

    .text-end {
        text-align: right;
    }

    .d-flex {
        display: flex;
    }

    .gap-2 {
        gap: 0.5rem;
    }

    .flex-fill {
        flex: 1;
    }

    .mb-0 {
        margin-bottom: 0;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
    }

    .col-md-3 {
        width: 25%;
        padding: 0 10px;
        box-sizing: border-box;
    }

    .align-items-end {
        align-items: flex-end;
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .filters-section .row > div {
            margin-bottom: 1rem;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .d-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .chart-container {
            height: 300px;
        }
        
        .col-md-3 {
            width: 100%;
            margin-bottom: 1rem;
        }
    }
</style>

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-car-front"></i> 
            Статистика по автомобилям
        </h1>
        <div class="d-flex gap-2">
            <span class="badge" style="background: linear-gradient(135deg, var(--primary-purple), #8e44ad); color: white; padding: 0.5rem 1rem; border-radius: 50px;">
                <i class="bi bi-bar-chart"></i> 
                @Model.Count автомобилей
            </span>
        </div>
    </div>

    <div class="stats-card">
        <div class="card-header">
            <h4>
                <i class="bi bi-bar-chart"></i> 
                Аналитика аренд автомобилей
            </h4>
        </div>
        <div class="card-body">
            <div class="filters-section">
                <form method="get" class="mb-0" id="filterForm">
                    <div class="row align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">
                                <i class="bi bi-calendar-range"></i> 
                                Период:
                            </label>
                            <select name="period" class="form-select" onchange="this.form.submit()">
                                <option value="all" selected="@(ViewBag.Period == "all")">Всё время</option>
                                <option value="month" selected="@(ViewBag.Period == "month")">За месяц</option>
                                <option value="halfyear" selected="@(ViewBag.Period == "halfyear")">За полгода</option>
                                <option value="year" selected="@(ViewBag.Period == "year")">За год</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">
                                <i class="bi bi-sort-numeric-up"></i> 
                                Количество:
                            </label>
                            <select name="top" class="form-select" onchange="this.form.submit()">
                                <option value="5" selected="@(ViewBag.TopCount == 5)">Топ 5 автомобилей</option>
                                <option value="10" selected="@(ViewBag.TopCount == 10)">Топ 10 автомобилей</option>
                                <option value="20" selected="@(ViewBag.TopCount == 20)">Топ 20 автомобилей</option>
                                <option value="50" selected="@(ViewBag.TopCount == 50)">Топ 50 автомобилей</option>
                                <option value="0" selected="@(ViewBag.TopCount == 0)">Все автомобили</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">
                                <i class="bi bi-sort-alpha-down"></i> 
                                Сортировка:
                            </label>
                            <select name="sortBy" class="form-select" onchange="this.form.submit()">
                                <option value="count" selected="@(ViewBag.SortBy == "count" ? "selected" : null)">По количеству аренд</option>
                                <option value="revenue" selected="@(ViewBag.SortBy == "revenue" ? "selected" : null)">По доходу</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="d-flex gap-2">
                                <button class="btn btn-success flex-fill" id="downloadCsvBtn">
                                    <i class="bi bi-file-earmark-excel"></i> 
                                    Экспорт CSV
                                </button>
                                <button class="btn btn-danger flex-fill" id="downloadPdfBtn">
                                    <i class="bi bi-file-earmark-pdf"></i> 
                                    Экспорт PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="chart-container">
                <canvas id="statsChart"></canvas>
            </div>

            <div class="table-container">
                <table class="table" id="statsTable">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">Номер</th>
                            <th>Автомобиль</th>
                            <th class="text-center">Аренды</th>
                            <th class="text-end">Доход (BYN)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var car = Model[i];
                            <tr>
                                <td class="text-center">
                                    <span class="rank-badge">@(i + 1)</span>
                                </td>
                                <td>
                                    <div class="car-info">
                                        <i class="bi bi-car-front"></i>
                                        <strong>@car.CarInfo</strong>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="stat-highlight">@car.RentalCount</span>
                                </td>
                                <td class="text-end">
                                    <span class="revenue-highlight">@car.TotalRevenue.ToString("N2")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const darkModeSwitch = document.getElementById('darkModeSwitch');
        if (darkModeSwitch) {
            const themeIcon = darkModeSwitch.nextElementSibling?.querySelector('i');
            const isDark = localStorage.getItem('darkMode') === 'true';
            if (isDark) {
                document.body.classList.add('dark-mode');
                darkModeSwitch.checked = true;
                if (themeIcon) {
                    themeIcon.classList.remove('bi-moon-stars');
                    themeIcon.classList.add('bi-sun');
                }
            }

            darkModeSwitch.addEventListener('change', function() {
                document.body.classList.toggle('dark-mode');
                localStorage.setItem('darkMode', this.checked);
                
                if (themeIcon) {
                    if (this.checked) {
                        themeIcon.classList.remove('bi-moon-stars');
                        themeIcon.classList.add('bi-sun');
                    } else {
                        themeIcon.classList.remove('bi-sun');
                        themeIcon.classList.add('bi-moon-stars');
                    }
                }
            });
        }
    });
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.19.3/package/dist/xlsx.full.min.js"></script>

    <script>
        var carStats = @Html.Raw(Json.Serialize(Model.Select(c => new { c.CarInfo, c.RentalCount, c.TotalRevenue })));
        var totalCars = @Model.Count;
        
        document.addEventListener('DOMContentLoaded', function() {
            initChart();
            setupDownloadButtons();
        });

        function initChart() {
            var ctx = document.getElementById('statsChart');
            if (!ctx) return;

            var carNames = carStats.map(c => c.carInfo);
            var rentalCounts = carStats.map(c => c.rentalCount);
            var revenues = carStats.map(c => c.totalRevenue);

            var backgroundColors = [];
            for (var i = 0; i < carNames.length; i++) {
                var hue = (i * 360 / (carNames.length || 1)) % 360;
                backgroundColors.push('hsla(' + hue + ', 70%, 50%, 0.7)');
            }

            new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: carNames,
                    datasets: [{
                        label: 'Количество аренд',
                        data: rentalCounts,
                        backgroundColor: backgroundColors,
                        borderColor: backgroundColors.map(function(c) { return c.replace('0.7', '1'); }),
                        borderWidth: 1,
                        borderRadius: 5,
                        barPercentage: 0.6
                    }, {
                        label: 'Доход (BYN)',
                        data: revenues,
                        backgroundColor: backgroundColors.map(function(c) { return c.replace('0.7', '0.3'); }),
                        borderColor: backgroundColors.map(function(c) { return c.replace('0.7', '1'); }),
                        borderWidth: 1,
                        type: 'line',
                        yAxisID: 'y1',
                        tension: 0.4,
                        pointBackgroundColor: backgroundColors.map(function(c) { return c.replace('0.7', '1'); }),
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: { size: 12, weight: '500' },
                                padding: 20
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0,0,0,0.8)',
                            titleFont: { size: 14, weight: 'bold' },
                            bodyFont: { size: 13 },
                            padding: 12,
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Количество аренд',
                                font: { size: 12, weight: '600' }
                            },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        y1: {
                            position: 'right',
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Доход (BYN)',
                                font: { size: 12, weight: '600' }
                            },
                            grid: { drawOnChartArea: false }
                        },
                        x: {
                            grid: { display: false },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        }
                    }
                }
            });
        }

        function setupDownloadButtons() {
            var csvBtn = document.getElementById('downloadCsvBtn');
            var pdfBtn = document.getElementById('downloadPdfBtn');
            if (csvBtn) csvBtn.addEventListener('click', downloadCsv);
            if (pdfBtn) pdfBtn.addEventListener('click', downloadPdf);
        }

        function downloadCsv() {
            try {
                var rows = Array.from(document.querySelectorAll('#statsTable tbody tr'));
                var csvContent = 'Номер,Автомобиль,Количество аренд,Доход (BYN)\n';
                
                for (var i = 0; i < rows.length; i++) {
                    var cols = rows[i].querySelectorAll('td');
                    csvContent += cols[0].textContent.trim() + ',' +
                                  cols[1].textContent.trim() + ',' +
                                  cols[2].textContent.trim() + ',' +
                                  cols[3].textContent.trim() + '\n';
                }

                var blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                var date = new Date().toISOString().slice(0,10);
                link.download = 'car_stats_' + date + '.csv';
                link.click();
                URL.revokeObjectURL(link.href);
            } catch (error) {
                console.error('CSV export error:', error);
                alert('Ошибка при создании CSV файла');
            }
        }

        async function downloadPdf() {
            try {
                var pdfBtn = document.getElementById('downloadPdfBtn');
                var originalText = pdfBtn.innerHTML;
                pdfBtn.innerHTML = '<i class="bi bi-hourglass"></i> Генерация PDF...';
                pdfBtn.disabled = true;

                var rows = Array.from(document.querySelectorAll('#statsTable tbody tr'));
                var tableRowsHtml = '';
                for (var i = 0; i < rows.length; i++) {
                    var cols = rows[i].querySelectorAll('td');
                    var num = cols[0].textContent.trim();
                    var car = cols[1].textContent.trim();
                    var rentals = cols[2].textContent.trim();
                    var revenue = cols[3].textContent.trim();
                    tableRowsHtml += `
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center; width: 10%;">${num}</td>
                            <td style="border: 1px solid #ddd; padding: 10px; width: 50%;">${car}</td>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: center; width: 20%;">${rentals}</td>
                            <td style="border: 1px solid #ddd; padding: 10px; text-align: right; width: 20%;">${revenue}</td>
                        </tr>
                    `;
                }

                var now = new Date();
                var dateStr = now.toLocaleDateString('ru-RU', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });

                var pdfHtml = `
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset="UTF-8">
                        <title>Статистика по автомобилям</title>
                        <style>
                            * { margin: 0; padding: 0; box-sizing: border-box; }
                            body { 
                                font-family: Arial, sans-serif; 
                                padding: 20px; 
                                background: white;
                                width: 800px;
                                margin: 0 auto;
                            }
                            .header {
                                text-align: center;
                                margin-bottom: 25px;
                                padding-bottom: 10px;
                                border-bottom: 2px solid #9b59b6;
                            }
                            .header h1 {
                                color: #9b59b6;
                                font-size: 24px;
                                margin-bottom: 8px;
                            }
                            .header p {
                                color: #666;
                                font-size: 12px;
                            }
                            .stats {
                                text-align: right;
                                margin-bottom: 20px;
                                color: #666;
                                font-size: 12px;
                            }
                            table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 10px;
                            }
                            th {
                                background: linear-gradient(135deg, #9b59b6, #8e44ad);
                                color: white;
                                padding: 12px 10px;
                                font-weight: bold;
                                text-align: center;
                                border: none;
                            }
                            td {
                                border: 1px solid #ddd;
                                padding: 10px;
                                color: #333;
                            }
                            .table-container {
                                width: 100%;
                                overflow-x: auto;
                            }
                        </style>
                    </head>
                    <body>
                        <div class="header">
                            <h1>Статистика по автомобилям</h1>
                            <p>Дата формирования: ${dateStr}</p>
                        </div>
                        <div class="stats">
                            Всего автомобилей: ${totalCars}
                        </div>
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width: 10%;">№</th>
                                        <th style="width: 50%;">Автомобиль</th>
                                        <th style="width: 20%;">Аренды</th>
                                        <th style="width: 20%;">Доход (BYN)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${tableRowsHtml}
                                </tbody>
                            </table>
                        </div>
                    </body>
                    </html>
                `;

                var iframe = document.createElement('iframe');
                iframe.style.position = 'absolute';
                iframe.style.top = '-9999px';
                iframe.style.left = '-9999px';
                iframe.style.width = '800px';
                iframe.style.height = '600px';
                document.body.appendChild(iframe);
                
                iframe.contentDocument.open();
                iframe.contentDocument.write(pdfHtml);
                iframe.contentDocument.close();
                
                await new Promise(resolve => setTimeout(resolve, 800));
                
                var canvas = await html2canvas(iframe.contentDocument.body, {
                    scale: 2,
                    backgroundColor: '#ffffff',
                    logging: false,
                    useCORS: true,
                    windowWidth: 800,
                    windowHeight: iframe.contentDocument.body.scrollHeight
                });
                
                document.body.removeChild(iframe);
                
                var imgData = canvas.toDataURL('image/png');
                var { jsPDF } = window.jspdf;
                
                var imgWidth = 280;
                var imgHeight = (canvas.height * imgWidth) / canvas.width;
                
                var doc = new jsPDF({
                    orientation: 'landscape',
                    unit: 'mm',
                    format: 'a4'
                });
                
                doc.addImage(imgData, 'PNG', 10, 10, imgWidth, imgHeight);
                
                var fileName = 'car_stats_' + new Date().toISOString().slice(0,10) + '.pdf';
                doc.save(fileName);
                
                pdfBtn.innerHTML = originalText;
                pdfBtn.disabled = false;
                
            } catch (error) {
                console.error('PDF export error:', error);
                alert('Ошибка при создании PDF файла: ' + error.message);
                var pdfBtn = document.getElementById('downloadPdfBtn');
                pdfBtn.innerHTML = '<i class="bi bi-file-earmark-pdf"></i> Экспорт PDF';
                pdfBtn.disabled = false;
            }
        }
    </script>
}