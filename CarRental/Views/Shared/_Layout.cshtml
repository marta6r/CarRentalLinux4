@* <!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarRental</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-blue: #3498db;
            --dark-blue: #2980b9;
            --dark-gray: #2c3e50;
        }

        body {
            background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                              url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            transition: background-image 0.3s ease;
        }

        body.dark-mode {
            background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), 
                              url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
        }

        /* Шапка на всю ширину */
        .navbar-custom {
            background: linear-gradient(135deg, rgba(44, 62, 80, 0.95), rgba(52, 152, 219, 0.95));
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            width: 100%;
        }

        body.dark-mode .navbar-custom {
            background: linear-gradient(135deg, rgba(30, 43, 58, 0.95), rgba(44, 62, 80, 0.95));
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 700;
        }

        .nav-link {
            font-size: 1.1rem;
            padding: 0.5rem 1rem !important;
            transition: all 0.3s ease;
        }

        .nav-link:hover {
            transform: translateY(-2px);
            text-shadow: 0 2px 5px rgba(0,0,0,0.3);
        }

        .nav-link.active {
            font-weight: 600;
            border-bottom: 2px solid white;
        }

        /* Основной контент */
        main {
            flex: 1;
            padding: 2rem 1rem;
        }

        /* Футер */
        footer {
            background: rgba(44, 62, 80, 0.95);
            backdrop-filter: blur(10px);
            color: white;
            padding: 1rem 0;
            text-align: center;
            width: 100%;
        }

        /* Переключатель темы */
        .theme-switch {
            margin-left: 1rem;
        }

        .form-switch .form-check-input {
            width: 3rem;
            height: 1.5rem;
            cursor: pointer;
        }

        .form-switch .form-check-input:checked {
            background-color: #3498db;
            border-color: #3498db;
        }

        /* Стили для карточек и таблиц в темной теме */
        body.dark-mode .card {
            background: rgba(45, 45, 45, 0.95);
            color: #f8f9fa;
            border-color: #404040;
        }

        body.dark-mode .table {
            color: #f8f9fa;
            background-color: transparent;
        }

        body.dark-mode .table td {
            color: #f8f9fa;
            border-bottom: 1px solid #404040;
        }

        body.dark-mode .page-header {
            background: rgba(45, 45, 45, 0.95);
        }

        body.dark-mode .page-header h1 {
            color: white;
        }

        /* Адаптивность */
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1.5rem;
            }
            
            .nav-link {
                font-size: 1rem;
                text-align: center;
            }
            
            .theme-switch {
                margin: 0.5rem 0 0 0;
                text-align: center;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Шапка на всю ширину -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-car-front-fill me-2"></i>CarRental
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="/">
                                <i class="bi bi-house-door me-1"></i>Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cars" ? "active" : "")" href="/Cars">
                                <i class="bi bi-car-front me-1"></i>Автомобили
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" href="/Customers">
                                <i class="bi bi-people me-1"></i>Клиенты
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rentals" ? "active" : "")" href="/Rentals">
                                <i class="bi bi-file-earmark-text me-1"></i>Аренды
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Statistics" ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-bar-chart me-1"></i>Статистика
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Statistics/Cars">Статистика авто</a></li>
                                <li><a class="dropdown-item" href="/Statistics/Customers">Статистика клиентов</a></li>
                            </ul>
                        </li>
                    </ul>
                    <div class="theme-switch">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="darkModeSwitch">
                            <label class="form-check-label text-white" for="darkModeSwitch">
                                <i class="bi bi-moon-stars fs-5" id="themeIcon"></i>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Основной контент -->
    <main>
        @RenderBody()
    </main>

    <!-- Футер -->
    <footer>
        <div class="container-fluid px-4 px-lg-5">
            <p class="mb-0">&copy; 2026 CarRental - Система управления арендой автомобилей</p>
        </div>
    </footer>

    <!-- jQuery (должен быть ПЕРВЫМ) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Скрипт для переключения темы (ОДИН, ИСПРАВЛЕННЫЙ) -->
    <script>
        // Функция для применения темы
        function applyTheme(isDark) {
            if (isDark) {
                document.body.classList.add('dark-mode');
            } else {
                document.body.classList.remove('dark-mode');
            }
            
            // Обновляем иконку
            const themeIcon = document.getElementById('themeIcon');
            if (themeIcon) {
                if (isDark) {
                    themeIcon.classList.remove('bi-moon-stars');
                    themeIcon.classList.add('bi-sun');
                } else {
                    themeIcon.classList.remove('bi-sun');
                    themeIcon.classList.add('bi-moon-stars');
                }
            }
            
            // Сохраняем в localStorage
            localStorage.setItem('darkMode', isDark);
        }

        // Ждем полной загрузки DOM
        document.addEventListener('DOMContentLoaded', function() {
            const darkModeSwitch = document.getElementById('darkModeSwitch');
            
            if (!darkModeSwitch) return; // Если переключатель не найден, выходим
            
            // Проверяем сохраненную тему
            const savedTheme = localStorage.getItem('darkMode');
            const isDark = savedTheme === 'true';
            
            // Устанавливаем начальное состояние
            darkModeSwitch.checked = isDark;
            applyTheme(isDark);
            
            // Обработчик переключения
            darkModeSwitch.addEventListener('change', function() {
                applyTheme(this.checked);
            });
        });
    </script>

    <!-- УДАЛИТЕ дублирующийся скрипт темы, который был ниже! -->
    <!-- Весь скрипт с document.addEventListener('DOMContentLoaded', function() { const darkModeSwitch... }) нужно УДАЛИТЬ -->

    <script src="~/js/decimal-formatter.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> *@











































