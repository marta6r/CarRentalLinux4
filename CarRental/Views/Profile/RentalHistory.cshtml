@model IEnumerable<CarRental.Models.Rental>

@{
    ViewData["Title"] = "История аренд";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-clock-history"></i> История аренд
        </h1>
        <p class="text-muted">Завершённые аренды автомобилей</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Автомобиль</th>
                        <th>Дата начала</th>
                        <th>Дата возврата</th>
                        <th>Стоимость</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        <tr>
                            <td>
                                <strong>@rental.Car?.Brand @rental.Car?.Model</strong><br />
                                <small class="text-muted">@rental.Car?.Year г.</small>
                            </td>
                            <td>@rental.RentDate.ToString("dd.MM.yyyy")</td>
                            <td>@rental.ReturnDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="fw-bold text-success">@rental.TotalPrice.ToString("N2") BYN</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">
                                    <i class="bi bi-check-circle"></i> Завершена
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <!-- Иконка белого цвета для светлой темы -->
            <i class="bi bi-clock-history" style="font-size: 4rem; opacity: 0.7; color: #ffffff;"></i>
            <!-- Заголовок белого цвета -->
            <h3 class="mt-3" style="color: #ffffff;">У вас нет завершённых аренд</h3>
            <!-- Подзаголовок белого/светлого цвета -->
            <p style="color: #f0f0f0;">После завершения аренды они появятся здесь</p>
            <a href="/User/Index" class="btn btn-primary rounded-pill mt-3">
                <i class="bi bi-car-front"></i> Выбрать автомобиль
            </a>
        </div>
    }
</div>

<style>
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: #3498db;
    }

    .table {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    body.dark-mode .table {
        background: rgba(45, 45, 45, 0.95);
        color: #f8f9fa;
    }

    .table th {
        background: rgba(52, 152, 219, 0.1);
        border: none;
    }

    body.dark-mode .table th {
        background: rgba(52, 152, 219, 0.2);
    }
</style>