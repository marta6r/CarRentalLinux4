@model CarRental.Models.Customer

@{
    ViewData["Title"] = "Добавление клиента";
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
        --primary-green: #2ecc71;
        --primary-dark-green: #27ae60;
        --primary-red: #e74c3c;
    }

    body {
        background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                          url('https://avatars.mds.yandex.net/get-altay/16430504/2a000001992a4d449da6e07938f4ba82eba3/orig');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    body.dark-mode {
        background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                          url('https://avatars.mds.yandex.net/get-altay/16430504/2a000001992a4d449da6e07938f4ba82eba3/orig');
    }

    /* Заголовок страницы */
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: var(--primary-green);
    }

    /* Карточка формы */
    .form-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .form-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .form-header {
        background: linear-gradient(135deg, var(--primary-green), var(--primary-dark-green));
        padding: 1.5rem 2rem;
    }

    .form-header h4 {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-body {
        padding: 2rem;
    }

    /* Поля формы */
    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-label i {
        color: var(--primary-green);
    }

    body.dark-mode .form-label {
        color: #f8f9fa;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid rgba(46, 204, 113, 0.2);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        color: #2c3e50;
        width: 100%;
    }

    .form-control::placeholder {
        color: #a0aec0;
        opacity: 1;
    }

    body.dark-mode .form-control {
        background: rgba(50, 50, 50, 0.9);
        border-color: rgba(255, 255, 255, 0.15);
        color: white;
    }

    body.dark-mode .form-control::placeholder {
        color: #a0aec0 !important;
        opacity: 0.8 !important;
    }

    .form-control:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 0.25rem rgba(46, 204, 113, 0.25);
        background: white;
    }

    body.dark-mode .form-control:focus {
        background: rgba(70, 70, 70, 0.9);
        border-color: var(--primary-green);
    }

    .form-text {
        color: #6c757d;
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .form-text {
        color: #adb5bd;
    }

    .form-text i {
        color: var(--primary-green);
    }

    /* Ошибки валидации */
    .text-danger {
        color: var(--primary-red);
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .validation-summary-errors {
        background: rgba(231, 76, 60, 0.1);
        border-left: 4px solid var(--primary-red);
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        color: #2c3e50;
    }

    body.dark-mode .validation-summary-errors {
        background: rgba(231, 76, 60, 0.2);
        color: #f8f9fa;
    }

    /* Кнопки */
    .btn {
        padding: 0.75rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-green), var(--primary-dark-green));
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(46, 204, 113, 0.4);
        color: white;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(149, 165, 166, 0.4);
        color: white;
    }

    /* Алерты */
    .alert {
        border-radius: 12px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }

    .alert-danger {
        background: linear-gradient(135deg, #fee, #fdd);
        color: #c0392b;
    }

    body.dark-mode .alert-success {
        background: linear-gradient(135deg, #1a3a1a, #1a2a1a);
        color: #a5d6a7;
    }

    body.dark-mode .alert-danger {
        background: linear-gradient(135deg, #3a1a1a, #2a1a1a);
        color: #e74c3c;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1rem;
            text-align: center;
        }
        
        .form-body {
            padding: 1rem;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .d-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .row > div {
            margin-bottom: 1rem;
        }
    }
</style>

<!-- Основной контент -->
<div class="container">
    <!-- Заголовок страницы -->
    <div class="page-header">
        <h1>
            <i class="bi bi-person-plus-fill"></i> @ViewData["Title"]
        </h1>
    </div>

    <!-- Форма -->
    <div class="form-card">
        <div class="form-header">
            <h4>
                <i class="bi bi-person-plus"></i> Введите данные нового клиента
            </h4>
        </div>
        <div class="form-body">
            <form asp-action="Create" method="post" id="createForm" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">
                            <i class="bi bi-person-circle"></i> Полное имя
                        </label>
                        <input asp-for="FullName" class="form-control" placeholder="Иванов Иван Иванович" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Введите полное имя клиента
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope"></i> Email
                        </label>
                        <input asp-for="Email" class="form-control" placeholder="ivan@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Введите действующий email
                        </small>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">
                            <i class="bi bi-telephone"></i> Телефон
                        </label>
                        <input asp-for="Phone" class="form-control" placeholder="+375291234567" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Формат: +375XXXXXXXXX (13 символов)
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PassportNumber" class="form-label">
                            <i class="bi bi-card-text"></i> Номер паспорта
                        </label>
                        <input asp-for="PassportNumber" class="form-control" placeholder="AB1234567" />
                        <span asp-validation-for="PassportNumber" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Формат: 2 буквы и 7 цифр (9 символов)
                        </small>
                    </div>
                </div>

                <!-- Поле для загрузки фото -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label asp-for="ImageFile" class="form-label">
                            <i class="bi bi-image"></i> Фото клиента
                        </label>
                        <input asp-for="ImageFile" class="form-control" type="file" accept="image/jpeg,image/png,image/gif,image/webp" />
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                        <small class="form-text">
                            <i class="bi bi-info-circle"></i> Поддерживаются форматы: JPG, JPEG, PNG, GIF, WEBP. Максимальный размер: 5MB
                        </small>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Назад
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}