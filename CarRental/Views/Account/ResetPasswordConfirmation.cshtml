@{
    ViewData["Title"] = "Пароль изменен";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container" style="max-width: 500px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle" style="font-size: 4rem; color: #27ae60;"></i>
            </div>
            <h3>Пароль успешно изменен!</h3>
            <p class="text-muted">@ViewBag.Message</p>
            
            <a href="/Account/Login" class="btn btn-primary mt-3">
                <i class="bi bi-box-arrow-in-right"></i> Войти
            </a>
        </div>
    </div>
</div>