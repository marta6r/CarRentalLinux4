@model IEnumerable<CarRental.Models.Customer>

@{
    ViewData["Title"] = "Сотрудники";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-people-fill"></i> Сотрудники
        </h1>
        <p class="text-muted">Управление персоналом компании</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-4">
        <a href="/Admin/CreateEmployee" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Добавить сотрудника
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-custom">
            <thead>
                <tr>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-person-badge me-1"></i> ФИО</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-envelope me-1"></i> Email</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-telephone me-1"></i> Телефон</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-card-text me-1"></i> Паспорт</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-shield-check me-1"></i> Должность</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-gear me-1"></i> Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr class="employee-row">
                        <td class="fw-semibold" style="text-align: center;">@employee.FullName</td>
                        <td style="text-align: center;">@employee.Email</td>
                        <td style="text-align: center;">@employee.Phone</td>
                        <td style="text-align: center;">@employee.PassportNumber</td>
                        <td style="text-align: center;">
                            @if (employee.Role == "admin")
                            {
                                <span class="badge-admin">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Администратор
                                </span>
                            }
                            else
                            {
                                <span class="badge-manager">
                                    <i class="bi bi-person-badge-fill me-1"></i> Менеджер
                                </span>
                            }
                        </td>
                        <td style="text-align: center;">
                            @if (employee.Role != "admin")
                            {
                                <form method="post" asp-action="DeleteEmployee" asp-route-id="@employee.Id" style="display:inline;">
                                    <button type="submit" class="btn-delete" onclick="return confirm('Удалить сотрудника @employee.FullName?')">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted" style="cursor: not-allowed;">
                                    <i class="bi bi-lock-fill me-1"></i> Нельзя удалить
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }
    
    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }
    
    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    body.dark-mode .page-header h1 {
        color: white;
    }
    
    .page-header h1 i {
        color: #e74c3c;
    }
    
    .text-muted {
        color: #6c757d;
        margin-top: 0.5rem;
        margin-bottom: 0;
    }
    
    body.dark-mode .text-muted {
        color: #adb5bd;
    }
    
    /* Алерты */
    .alert {
        border-radius: 12px;
        border: none;
        display: flex;
        align-items: center;
    }
    
    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }
    
    .alert-danger {
        background: linear-gradient(135deg, #fee, #fdd);
        color: #c0392b;
    }
    
    body.dark-mode .alert-success {
        background: linear-gradient(135deg, #1a3a1a, #1a2a1a);
        color: #a5d6a7;
    }
    
    body.dark-mode .alert-danger {
        background: linear-gradient(135deg, #3a1a1a, #2a1a1a);
        color: #e74c3c;
    }
    
    /* Кнопка добавления */
    .btn-primary {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(231, 76, 60, 0.4);
        background: linear-gradient(135deg, #c0392b, #a93226);
    }
    
    /* Таблица */
    .table-custom {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        backdrop-filter: blur(5px);
    }
    
    body.dark-mode .table-custom {
        background: rgba(45, 45, 45, 0.95);
        color: #e0e0e0;
    }
    
    /* ШАПКА ТАБЛИЦЫ - КРАСНЫЙ ФОН */
    .table-custom thead tr {
        background: #e74c3c !important;
    }
    
    .table-custom thead th {
        background: #e74c3c !important;
        color: white !important;
        font-weight: 600 !important;
        padding: 1rem !important;
        border: none !important;
        font-size: 0.9rem !important;
        text-align: center !important;
    }
    
    /* Для темной темы */
    body.dark-mode .table-custom thead tr {
        background: #c0392b !important;
    }
    
    body.dark-mode .table-custom thead th {
        background: #c0392b !important;
        color: white !important;
    }
    
    .table-custom tbody tr {
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    
    body.dark-mode .table-custom tbody tr {
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    
    .table-custom tbody tr:hover {
        background: rgba(231, 76, 60, 0.08);
        transform: scale(1.01);
    }
    
    body.dark-mode .table-custom tbody tr:hover {
        background: rgba(231, 76, 60, 0.15);
    }
    
    .table-custom td {
        padding: 1rem;
        vertical-align: middle;
        text-align: center;
    }
    
    /* Бейджи ролей */
    .badge-admin {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: white;
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    
    .badge-manager {
        background: linear-gradient(135deg, #f39c12, #e67e22);
        color: white;
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    
    /* Кнопка удаления */
    .btn-delete {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: white;
        border: none;
        padding: 0.35rem 0.8rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }
    
    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
    }
    
    /* Анимация строк */
    .employee-row {
        animation: fadeInUp 0.5s ease-out;
    }
    
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1rem;
        }
        
        .page-header h1 {
            font-size: 1.5rem;
        }
        
        .table-custom thead th {
            font-size: 0.7rem !important;
            padding: 0.5rem !important;
        }
        
        .table-custom td {
            padding: 0.5rem;
            font-size: 0.75rem;
        }
        
        .badge-admin, .badge-manager {
            font-size: 0.65rem;
            padding: 0.2rem 0.5rem;
        }
        
        .btn-delete {
            padding: 0.2rem 0.5rem;
        }
    }
</style>