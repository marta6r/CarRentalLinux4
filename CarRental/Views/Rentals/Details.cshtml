@model CarRental.Models.Rental

@{
    ViewData["Title"] = "Характеристики аренды";
    
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
        --bg-light: rgba(255, 255, 255, 0.95);
        --bg-dark: rgba(30, 30, 35, 0.95);
        --card-bg-light: rgba(255, 255, 255, 0.95);
        --card-bg-dark: rgba(30, 30, 35, 0.95);
        --border-light: rgba(0, 0, 0, 0.05);
        --border-dark: rgba(255, 255, 255, 0.05);
    }

    body {
        background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        transition: all 0.3s ease;
    }

    body.dark-mode {
        background-image: linear-gradient(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
    }

    .page-header {
        background: var(--bg-light);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header {
        background: var(--bg-dark);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: #f1c40f;
    }

    .details-card {
        background: var(--card-bg-light);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }

    body.dark-mode .details-card {
        background: var(--card-bg-dark);
    }

    .card-header {
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        padding: 1.5rem 2rem;
        border: none;
    }

    .card-header h4 {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    /* Стили для PDF контента */
    .info-section {
        background: rgba(241, 196, 15, 0.03);
        border-radius: 15px;
        padding: 1rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .info-section {
        background: rgba(255, 255, 255, 0.08);
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 2px solid rgba(241, 196, 15, 0.3);
        padding-bottom: 0.3rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .section-title {
        color: #f8f9fa;
        border-bottom-color: rgba(241, 196, 15, 0.5);
    }

    .section-title i {
        color: #f1c40f;
        font-size: 1rem;
    }

    .info-row {
        display: flex;
        margin-bottom: 0.5rem;
        padding: 0.3rem 0;
        border-bottom: 1px solid var(--border-light);
        transition: all 0.3s ease;
    }

    body.dark-mode .info-row {
        border-bottom-color: var(--border-dark);
    }

    .info-label {
        width: 130px;
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .info-label {
        color: #f8f9fa;
    }

    .info-label i {
        color: #f1c40f;
        width: 18px;
        font-size: 0.85rem;
    }

    .info-value {
        flex: 1;
        color: #6c757d;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .info-value {
        color: #c0c0c0;
    }

    .price-highlight {
        font-weight: 700;
        color: #f39c12;
        font-size: 1rem;
    }

    body.dark-mode .price-highlight {
        color: #f1c40f;
    }

    .duration-highlight {
        font-weight: 600;
        color: #3498db;
    }

    body.dark-mode .duration-highlight {
        color: #5dade2;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.6rem;
        border-radius: 50px;
        font-weight: 500;
        font-size: 0.75rem;
    }

    .badge.bg-success {
        background: linear-gradient(135deg, #2ecc71, #27ae60) !important;
        color: white;
    }

    .badge.bg-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d) !important;
        color: white;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(241, 196, 15, 0.4);
        color: white;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(149, 165, 166, 0.4);
        color: white;
    }

    .btn i {
        font-size: 1rem;
    }

    .buttons-container {
        margin-top: 1.5rem;
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    /* Стили для скрытого PDF контента */
    .pdf-temp {
        position: absolute;
        top: -9999px;
        left: -9999px;
        width: 800px;
        background: white;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .pdf-header {
        text-align: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #f1c40f;
    }

    .pdf-header h2 {
        color: #f1c40f;
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 0.3rem 0;
    }

    .pdf-header p {
        color: #6c757d;
        font-size: 0.8rem;
        margin: 0;
    }

    .pdf-info-section {
        background: rgba(241, 196, 15, 0.03);
        border-radius: 15px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .pdf-section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 2px solid rgba(241, 196, 15, 0.3);
        padding-bottom: 0.3rem;
    }

    .pdf-section-title i {
        color: #f1c40f;
    }

    .pdf-info-row {
        display: flex;
        margin-bottom: 0.5rem;
        padding: 0.3rem 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .pdf-info-label {
        width: 130px;
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
    }

    .pdf-info-label i {
        color: #f1c40f;
    }

    .pdf-info-value {
        flex: 1;
        color: #6c757d;
        font-size: 0.85rem;
    }

    .pdf-price-highlight {
        font-weight: 700;
        color: #f39c12;
    }

    .pdf-duration-highlight {
        font-weight: 600;
        color: #3498db;
    }

    .pdf-badge-success {
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 50px;
        font-size: 0.75rem;
        display: inline-block;
    }

    .pdf-badge-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 50px;
        font-size: 0.75rem;
        display: inline-block;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1rem;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .info-row {
            flex-direction: column;
            gap: 0.2rem;
        }
        
        .info-label {
            width: 100%;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .buttons-container {
            flex-direction: column;
        }
    }
</style>

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-file-text"></i> @ViewData["Title"]
        </h1>
    </div>

    <div class="details-card">
        <div class="card-header">
            <h4>
                <i class="bi bi-file-earmark-text"></i> Аренда #@Model.Id
            </h4>
        </div>
        <div class="card-body">
            <!-- Контент для отображения на странице -->
            <div class="info-section">
                <div class="section-title">
                    <i class="bi bi-car-front"></i> Информация об автомобиле
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-tag"></i> Марка</span>
                    <span class="info-value">@(Model.Car != null ? Model.Car.Brand : "Не указано")</span>
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-tag"></i> Модель</span>
                    <span class="info-value">@(Model.Car != null ? Model.Car.Model : "Не указано")</span>
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-calendar"></i> Год выпуска</span>
                    <span class="info-value">@(Model.Car != null ? Model.Car.Year.ToString() : "Не указано")</span>
                </div>
                
                @if (Model.Car != null)
                {
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-check-circle"></i> Статус авто</span>
                        <span class="info-value">
                            @if (Model.Car.IsAvailable)
                            {
                                <span class="badge bg-success">Доступен</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Занят</span>
                            }
                        </span>
                    </div>
                }
            </div>

            <div class="info-section">
                <div class="section-title">
                    <i class="bi bi-person-circle"></i> Информация о клиенте
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-person-badge"></i> ФИО</span>
                    <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "Не указано")</span>
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-telephone"></i> Телефон</span>
                    <span class="info-value">@(Model.Customer != null ? Model.Customer.Phone : "Не указано")</span>
                </div>
                
                @if (Model.Customer != null)
                {
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-envelope"></i> Email</span>
                        <span class="info-value">@Model.Customer.Email</span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-card-text"></i> Паспорт</span>
                        <span class="info-value">@Model.Customer.PassportNumber</span>
                    </div>
                }
            </div>

            <div class="info-section">
                <div class="section-title">
                    <i class="bi bi-calendar-check"></i> Детали аренды
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-calendar-start"></i> Дата начала</span>
                    <span class="info-value">@Model.RentDate.ToString("dd.MM.yyyy")</span>
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-calendar-end"></i> Дата возврата</span>
                    <span class="info-value">@Model.ReturnDate.ToString("dd.MM.yyyy")</span>
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-hourglass"></i> Длительность</span>
                    <span class="info-value">
                        <span class="duration-highlight">@((Model.ReturnDate - Model.RentDate).Days)</span> дней
                    </span>
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-info-circle"></i> Статус</span>
                    <span class="info-value">
                        @if (Model.ReturnDate >= DateTime.Now)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle"></i> Активна
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                <i class="bi bi-clock-history"></i> Завершена
                            </span>
                        }
                    </span>
                </div>
            </div>

            <div class="info-section">
                <div class="section-title">
                    <i class="bi bi-currency-exchange"></i> Финансовая информация
                </div>
                
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-calculator"></i> Стоимость</span>
                    <span class="info-value">
                        <span class="price-highlight">@Model.TotalPrice.ToString("N2") BYN</span>
                    </span>
                </div>
                
                @if (Model.Car != null)
                {
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-tag"></i> Цена за день</span>
                        <span class="info-value">@Model.Car.DailyPrice.ToString("N2") BYN</span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calculator"></i> Расчет</span>
                        <span class="info-value">
                            @Model.Car.DailyPrice.ToString("N2") BYN × @((Model.ReturnDate - Model.RentDate).Days) дней = 
                            <span class="price-highlight">@Model.TotalPrice.ToString("N2") BYN</span>
                        </span>
                    </div>
                }
            </div>

            <!-- Кнопки действий -->
            <div class="buttons-container">
                <button id="exportPdfBtn" class="btn btn-primary">
                    <i class="bi bi-file-earmark-pdf"></i> Чек в PDF
                </button>
                <a href="@Url.Action("Index", "Rentals")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Назад к списку аренд
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Скрипт для темной темы
    document.addEventListener('DOMContentLoaded', function() {
        const darkModeSwitch = document.getElementById('darkModeSwitch');
        if (darkModeSwitch) {
            const themeIcon = darkModeSwitch.nextElementSibling?.querySelector('i');
            const isDark = localStorage.getItem('darkMode') === 'true';
            if (isDark) {
                document.body.classList.add('dark-mode');
                darkModeSwitch.checked = true;
                if (themeIcon) {
                    themeIcon.classList.remove('bi-moon-stars');
                    themeIcon.classList.add('bi-sun');
                }
            }

            darkModeSwitch.addEventListener('change', function() {
                document.body.classList.toggle('dark-mode');
                localStorage.setItem('darkMode', this.checked);
                
                if (themeIcon) {
                    if (this.checked) {
                        themeIcon.classList.remove('bi-moon-stars');
                        themeIcon.classList.add('bi-sun');
                    } else {
                        themeIcon.classList.remove('bi-sun');
                        themeIcon.classList.add('bi-moon-stars');
                    }
                }
            });
        }
    });
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <script>
        // Получаем данные из модели через JavaScript переменные
        var rentalId = @Model.Id;
        var carBrand = @Html.Raw(Json.Serialize(Model.Car != null ? Model.Car.Brand : "Не указано"));
        var carModel = @Html.Raw(Json.Serialize(Model.Car != null ? Model.Car.Model : "Не указано"));
        var carYear = @(Model.Car != null ? Model.Car.Year.ToString() : "Не указано");
        var carIsAvailable = @(Model.Car != null ? (Model.Car.IsAvailable ? "true" : "false") : "false");
        var customerFullName = @Html.Raw(Json.Serialize(Model.Customer != null ? Model.Customer.FullName : "Не указано"));
        var customerPhone = @Html.Raw(Json.Serialize(Model.Customer != null ? Model.Customer.Phone : "Не указано"));
        var customerEmail = @Html.Raw(Json.Serialize(Model.Customer != null ? Model.Customer.Email : "Не указано"));
        var customerPassport = @Html.Raw(Json.Serialize(Model.Customer != null ? Model.Customer.PassportNumber : "Не указано"));
        var rentDate = "@Model.RentDate.ToString("dd.MM.yyyy")";
        var returnDate = "@Model.ReturnDate.ToString("dd.MM.yyyy")";
        var duration = @((Model.ReturnDate - Model.RentDate).Days);
        var totalPrice = @Model.TotalPrice.ToString("N2");
        var dailyPrice = @(Model.Car != null ? Model.Car.DailyPrice.ToString("N2") : "0.00");
        var isActive = @(Model.ReturnDate >= DateTime.Now ? "true" : "false");
        
        document.addEventListener('DOMContentLoaded', function() {
            const pdfButton = document.getElementById('exportPdfBtn');
            
            if (pdfButton) {
                pdfButton.addEventListener('click', async function() {
                    const originalText = pdfButton.innerHTML;
                    pdfButton.innerHTML = '<i class="bi bi-hourglass"></i> Генерация PDF...';
                    pdfButton.disabled = true;
                    
                    try {
                        await generatePdf();
                    } catch (error) {
                        console.error('Ошибка:', error);
                        alert('Не удалось сгенерировать PDF: ' + error.message);
                    } finally {
                        pdfButton.innerHTML = originalText;
                        pdfButton.disabled = false;
                    }
                });
            }
        });
        
        async function generatePdf() {
            // Создаем временный элемент
            const tempDiv = document.createElement('div');
            tempDiv.className = 'pdf-temp';
            tempDiv.innerHTML = getPdfHtml();
            document.body.appendChild(tempDiv);
            
            // Ждем рендеринга
            await new Promise(resolve => setTimeout(resolve, 100));
            
            // Конвертируем в canvas
            const canvas = await html2canvas(tempDiv, {
                scale: 2,
                backgroundColor: '#ffffff',
                logging: false,
                useCORS: true
            });
            
            // Удаляем временный элемент
            document.body.removeChild(tempDiv);
            
            // Создаем PDF
            const imgData = canvas.toDataURL('image/png');
            const { jsPDF } = window.jspdf;
            
            const imgWidth = 190;
            const imgHeight = (canvas.height * imgWidth) / canvas.width;
            
            const doc = new jsPDF({
                orientation: 'portrait',
                unit: 'mm',
                format: 'a4'
            });
            
            doc.addImage(imgData, 'PNG', 10, 10, imgWidth, imgHeight);
            doc.save(`Аренда_${rentalId}_${new Date().toISOString().slice(0,10)}.pdf`);
        }
        
        function getPdfHtml() {
            return `
                <div class="pdf-header">
                    <h2 style="color: #f1c40f !important;">ЧЕК АРЕНДЫ АВТОМОБИЛЯ</h2>
                    <p style="color: #6c757d;">Аренда №${rentalId}</p>
                </div>
                
                <div class="pdf-info-section">
                    <div class="pdf-section-title" style="color: #2c3e50;">
                        <i class="bi bi-car-front"></i> Информация об автомобиле
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-tag"></i> Марка</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${escapeHtml(carBrand)}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-tag"></i> Модель</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${escapeHtml(carModel)}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-calendar"></i> Год выпуска</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${carYear}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-check-circle"></i> Статус авто</span>
                        <span class="pdf-info-value" style="color: #6c757d;">
                            ${carIsAvailable ? '<span class="pdf-badge-success">Доступен</span>' : '<span class="pdf-badge-secondary">Занят</span>'}
                        </span>
                    </div>
                </div>
                
                <div class="pdf-info-section">
                    <div class="pdf-section-title" style="color: #2c3e50;">
                        <i class="bi bi-person-circle"></i> Информация о клиенте
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-person-badge"></i> ФИО</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${escapeHtml(customerFullName)}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-telephone"></i> Телефон</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${escapeHtml(customerPhone)}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-envelope"></i> Email</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${escapeHtml(customerEmail)}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-card-text"></i> Паспорт</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${escapeHtml(customerPassport)}</span>
                    </div>
                </div>
                
                <div class="pdf-info-section">
                    <div class="pdf-section-title" style="color: #2c3e50;">
                        <i class="bi bi-calendar-check"></i> Детали аренды
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-calendar-start"></i> Дата начала</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${rentDate}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-calendar-end"></i> Дата возврата</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${returnDate}</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-hourglass"></i> Длительность</span>
                        <span class="pdf-info-value" style="color: #6c757d;">
                            <span class="pdf-duration-highlight" style="color: #3498db;">${duration}</span> дней
                        </span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-info-circle"></i> Статус</span>
                        <span class="pdf-info-value" style="color: #6c757d;">
                            ${isActive ? '<span class="pdf-badge-success">Активна</span>' : '<span class="pdf-badge-secondary">Завершена</span>'}
                        </span>
                    </div>
                </div>
                
                <div class="pdf-info-section">
                    <div class="pdf-section-title" style="color: #2c3e50;">
                        <i class="bi bi-currency-exchange"></i> Финансовая информация
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-calculator"></i> Стоимость</span>
                        <span class="pdf-info-value" style="color: #6c757d;">
                            <span class="pdf-price-highlight" style="color: #f39c12;">${totalPrice} BYN</span>
                        </span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-tag"></i> Цена за день</span>
                        <span class="pdf-info-value" style="color: #6c757d;">${dailyPrice} BYN</span>
                    </div>
                    <div class="pdf-info-row">
                        <span class="pdf-info-label" style="color: #2c3e50;"><i class="bi bi-calculator"></i> Расчет</span>
                        <span class="pdf-info-value" style="color: #6c757d;">
                            ${dailyPrice} BYN × ${duration} дней = 
                            <span class="pdf-price-highlight" style="color: #f39c12;">${totalPrice} BYN</span>
                        </span>
                    </div>
                </div>
            `;
        }
        
        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }
    </script>
}