@model IEnumerable<CarRental.Models.Car>

@{
    ViewData["Title"] = "Автомобили - Пользовательский режим";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    .cars-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .car-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
    }

    body.dark-mode .car-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .car-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    .card-img-top {
        height: 200px;
        object-fit: cover;
        width: 100%;
    }

    .card-body {
        padding: 1.5rem;
    }

    .price {
        color: #27ae60;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: #3498db;
    }

    .ai-search-section {
        margin-bottom: 2rem;
    }

    .ai-search-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    body.dark-mode .ai-search-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .ai-search-card .card-body {
        padding: 1.5rem;
    }

    /* Сетка для поисковой строки */
    .ai-search-row {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
    }

    .ai-search-input-wrapper {
        flex: 1;
        min-width: 0;
    }

    .ai-search-btn-wrapper {
        flex-shrink: 0;
    }

    .btn-ai-search {
        background: linear-gradient(135deg, #6c5ce7, #a363d9);
        border: none;
        transition: all 0.3s ease;
        padding: 0.375rem 0.75rem;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        white-space: nowrap;
        height: 100%;
    }
    
    /* Делаем кнопку такой же высоты, как поле ввода */
    .ai-search-btn-wrapper {
        display: flex;
        align-items: stretch;
    }
    
    .btn-ai-search {
        height: auto;
        min-height: 38px;
    }

    .btn-ai-search:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(108, 92, 231, 0.4);
        background: linear-gradient(135deg, #5a4bcf, #8a4bc9);
    }

    /* Стили для кнопки микрофона */
    .btn-mic {
        transition: all 0.3s ease;
        border-left: none !important;
    }

    .btn-mic.listening {
        background: linear-gradient(135deg, #6c5ce7, #a363d9);
        color: white;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(108, 92, 231, 0.7);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(108, 92, 231, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(108, 92, 231, 0);
        }
    }

    .loading-spinner {
        display: none;
        text-align: center;
        padding: 1rem;
    }

    .spinner-border {
        width: 2rem;
        height: 2rem;
    }

    #resetSearchContainer {
        margin-bottom: 1rem;
        text-align: right;
    }

    .btn-reset {
        background: linear-gradient(135deg, #cf0e0e, #950e0e);
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-reset:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
        color: white;
    }

    .nothing-found {
        color: #ffffff !important;
    }

    .nothing-found h3 {
        color: #ffffff !important;
    }

    .nothing-found .text-muted {
        color: #f0f0f0 !important;
    }

    body.dark-mode .nothing-found h3 {
        color: #e0e0e0 !important;
    }

    body.dark-mode .nothing-found .text-muted {
        color: #b0b0b0 !important;
    }

    .voice-status {
        font-size: 0.8rem;
        margin-top: 0.5rem;
    }

    /* Адаптивность для мобильных устройств */
    @@media (max-width: 768px) {
        .ai-search-row {
            flex-direction: column;
        }
        
        .btn-ai-search {
            width: 100%;
            padding: 0.6rem 1rem;
        }
    }
</style>

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-car-front"></i> Доступные автомобили
        </h1>
    </div>

    <!-- Блок AI поиска -->
    <div class="ai-search-section">
        <div class="ai-search-card">
            <div class="card-body">
                <div class="ai-search-row">
                    <div class="ai-search-input-wrapper">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="bi bi-robot" style="color: #6c5ce7;"></i>
                            </span>
                            <input type="text" id="aiSearchInput" class="form-control border-start-0" 
                                   placeholder="Опишите, что вы ищете.">
                            <button class="btn btn-outline-secondary btn-mic" id="voiceSearchBtn" type="button" 
                                    style="border-left: none;" title="Голосовой поиск">
                                <i class="bi bi-mic" id="micIcon"></i>
                            </button>
                        </div>
                        <div id="voiceStatus" class="voice-status" style="display: none;">
                            <i class="bi bi-mic-fill" style="color: #6c5ce7;"></i> Слушаю...
                        </div>
                        <small class="text-muted mt-1 d-block">
                            <i class="bi bi-info-circle"></i> Искусственный интеллект подберет автомобили по вашему описанию
                        </small>
                    </div>
                    <div class="ai-search-btn-wrapper">
                        <button id="aiSearchBtn" class="btn btn-ai-search">
                            <i class="bi bi-search"></i> AI Поиск
                        </button>
                    </div>
                </div>
                <div id="aiSearchLoading" class="loading-spinner">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                    <p class="mt-2 text-muted">ИИ анализирует запрос и подбирает автомобили...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Кнопка сброса поиска -->
    <div id="resetSearchContainer" style="display: none;">
        <button id="resetSearchBtn" class="btn-reset">
            <i class="bi bi-arrow-repeat"></i> Показать все автомобили
        </button>
    </div>

    <!-- Контейнер для списка автомобилей -->
    <div id="carsContainer">
        @if (Model != null && Model.Any())
        {
            <div class="cars-grid" id="carsGrid">
                @foreach (var car in Model)
                {
                    <div class="car-card" data-car-id="@car.Id">
                        @if (!string.IsNullOrEmpty(car.ImagePath))
                        {
                            <img src="@car.ImagePath" class="card-img-top" alt="@car.Brand @car.Model">
                        }
                        else
                        {
                            <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #3498db, #2980b9); height: 200px;">
                                <i class="bi bi-car-front" style="font-size: 4rem; color: white;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h4>@car.Brand @car.Model</h4>
                            <p class="text-muted">
                                <i class="bi bi-calendar"></i> @car.Year г. |
                                <i class="bi bi-tag"></i> @(car.Category?.Name ?? "Без категории")
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="price">
                                    @car.DailyPrice.ToString("N2") BYN <span class="small fw-normal">/ день</span>
                                </div>
                                <a href="/User/Details/@car.Id" class="btn btn-primary">
                                    Подробнее <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 nothing-found" id="noCarsMessage">
                <i class="bi bi-car-front" style="font-size: 4rem; opacity: 0.5; color: #ffffff;"></i>
                <h3 class="mt-3">Автомобили не найдены</h3>
                <p class="text-muted">На данный момент нет доступных автомобилей</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <style>
        /* Стили для кастомного модального окна */
        .custom-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        
        .custom-modal-content {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            width: 400px;
            max-width: 90%;
            text-align: center;
            animation: modalSlideIn 0.3s ease-out;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }
        
        body.dark-mode .custom-modal-content {
            background: rgba(45, 45, 45, 0.98);
        }
        
        @@keyframes modalSlideIn {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
        
        .modal-header-custom {
            background: linear-gradient(135deg, #6c5ce7, #a363d9);
            padding: 1.2rem;
            border-radius: 20px 20px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .modal-header-custom h3 {
            margin: 0;
            color: white;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .modal-close {
            background: none;
            border: none;
            font-size: 28px;
            cursor: pointer;
            color: white;
            transition: transform 0.2s;
        }
        
        .modal-close:hover {
            transform: scale(1.1);
        }
        
        .modal-body-custom {
            padding: 1.5rem;
        }
        
        .modal-body-custom i {
            font-size: 4rem;
            color: #6c5ce7;
            margin-bottom: 1rem;
        }
        
        .modal-body-custom p {
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
            color: #2c3e50;
        }
        
        body.dark-mode .modal-body-custom p {
            color: #f8f9fa;
        }
        
        .modal-btn {
            background: linear-gradient(135deg, #6c5ce7, #a363d9);
            color: white;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .modal-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 92, 231, 0.4);
        }
    </style>

    <!-- Модальное окно для пустого запроса -->
    <div id="customAlertModal" class="custom-modal">
        <div class="custom-modal-content">
            <div class="modal-header-custom">
                <h3>
                    <i class="bi bi-info-circle"></i> Внимание
                </h3>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body-custom">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <p>Пожалуйста, опишите, какой автомобиль вы ищете</p>
                <button class="modal-btn" onclick="closeModal()">Хорошо</button>
            </div>
        </div>
    </div>

    <!-- Модальное окно для ошибки поддержки браузера -->
    <div id="browserSupportModal" class="custom-modal">
        <div class="custom-modal-content">
            <div class="modal-header-custom" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">
                <h3>
                    <i class="bi bi-browser-chrome"></i> Неподдерживаемый браузер
                </h3>
                <button class="modal-close" onclick="closeBrowserModal()">&times;</button>
            </div>
            <div class="modal-body-custom">
                <i class="bi bi-exclamation-triangle-fill" style="color: #e74c3c;"></i>
                <p>Ваш браузер не поддерживает голосовой поиск.</p>
                <p style="font-size: 0.9rem; color: #6c757d;">Пожалуйста, используйте Chrome, Edge или Safari.</p>
                <button class="modal-btn" onclick="closeBrowserModal()" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">
                    Хорошо
                </button>
            </div>
        </div>
    </div>

    <script>
        // Функции для модального окна пустого запроса
        function showCustomAlert() {
            const modal = document.getElementById('customAlertModal');
            if (modal) {
                modal.style.display = 'flex';
            }
        }
        
        function closeModal() {
            const modal = document.getElementById('customAlertModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }
        
        // Функции для модального окна ошибки браузера
        function showBrowserSupportModal() {
            const modal = document.getElementById('browserSupportModal');
            if (modal) {
                modal.style.display = 'flex';
            }
        }
        
        function closeBrowserModal() {
            const modal = document.getElementById('browserSupportModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }
        
        // Закрытие по клику на фон
        document.getElementById('customAlertModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
        
        document.getElementById('browserSupportModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeBrowserModal();
            }
        });
        
        // Закрытие по Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
                closeBrowserModal();
            }
        });

        // Сохранение последнего поиска
        function saveLastSearch(query, cars) {
            sessionStorage.setItem('lastSearchQuery', query);
            sessionStorage.setItem('lastSearchResults', JSON.stringify(cars));
        }
        
        // Восстановление последнего поиска
        function restoreLastSearch() {
            const savedQuery = sessionStorage.getItem('lastSearchQuery');
            const savedResults = sessionStorage.getItem('lastSearchResults');
            
            if (savedQuery && savedResults) {
                const searchInput = document.getElementById('aiSearchInput');
                if (searchInput) {
                    searchInput.value = savedQuery;
                }
                
                const cars = JSON.parse(savedResults);
                updateCarsList(cars);
                
                if (cars && cars.length > 0) {
                    document.getElementById('resetSearchContainer').style.display = 'block';
                } else if (cars && cars.length === 0) {
                    document.getElementById('resetSearchContainer').style.display = 'block';
                }
            }
        }
        
        // Очистка сохранённого поиска
        function clearSavedSearch() {
            sessionStorage.removeItem('lastSearchQuery');
            sessionStorage.removeItem('lastSearchResults');
        }

        // ==================== ГОЛОСОВОЙ ПОИСК ====================
        let recognition = null;
        let isListening = false;

        // Проверяем поддержку браузером
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            
            recognition.lang = 'ru-RU';
            recognition.continuous = false;
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;
            
            recognition.onresult = function(event) {
                const transcript = event.results[0][0].transcript;
                console.log("Распознано:", transcript);
                
                const searchInput = document.getElementById('aiSearchInput');
                searchInput.value = transcript;
                
                const voiceStatus = document.getElementById('voiceStatus');
                voiceStatus.innerHTML = `<i class="bi bi-check-circle-fill" style="color: #27ae60;"></i> Распознано: "${transcript}"`;
                voiceStatus.style.display = 'block';
                setTimeout(() => {
                    voiceStatus.style.display = 'none';
                }, 2000);
                
                document.getElementById('aiSearchBtn').click();
                stopListening();
            };
            
            recognition.onerror = function(event) {
                console.error("Ошибка распознавания:", event.error);
                const voiceStatus = document.getElementById('voiceStatus');
                
                let errorMsg = "";
                switch(event.error) {
                    case 'not-allowed':
                        errorMsg = "Нет доступа к микрофону";
                        break;
                    case 'no-speech':
                        errorMsg = "Речь не обнаружена";
                        break;
                    case 'network':
                        errorMsg = "Ошибка сети";
                        break;
                    default:
                        errorMsg = "Ошибка распознавания";
                }
                
                voiceStatus.innerHTML = `<i class="bi bi-exclamation-triangle-fill" style="color: #e74c3c;"></i> ${errorMsg}`;
                voiceStatus.style.display = 'block';
                setTimeout(() => {
                    voiceStatus.style.display = 'none';
                }, 2000);
                
                stopListening();
            };
            
            recognition.onend = function() {
                stopListening();
            };
            
            recognition.onstart = function() {
                console.log("Начало записи");
                const voiceStatus = document.getElementById('voiceStatus');
                voiceStatus.style.display = 'block';
                voiceStatus.innerHTML = '<i class="bi bi-mic-fill" style="color: #6c5ce7; animation: pulse 1s infinite;"></i> Слушаю...';
            };
        }

        function startListening() {
            if (!recognition) {
                showBrowserSupportModal();
                return;
            }
            
            if (isListening) {
                stopListening();
                return;
            }
            
            isListening = true;
            
            const micBtn = document.getElementById('voiceSearchBtn');
            const micIcon = document.getElementById('micIcon');
            micBtn.classList.add('listening');
            micIcon.classList.remove('bi-mic');
            micIcon.classList.add('bi-mic-fill');
            
            recognition.start();
        }

        function stopListening() {
            if (recognition && isListening) {
                recognition.stop();
            }
            
            isListening = false;
            
            const micBtn = document.getElementById('voiceSearchBtn');
            const micIcon = document.getElementById('micIcon');
            micBtn.classList.remove('listening');
            micIcon.classList.remove('bi-mic-fill');
            micIcon.classList.add('bi-mic');
            
            const voiceStatus = document.getElementById('voiceStatus');
            if (voiceStatus && voiceStatus.style.display !== 'none') {
                setTimeout(() => {
                    voiceStatus.style.display = 'none';
                }, 500);
            }
        }

        // ==================== ОСНОВНАЯ ЛОГИКА ====================
        
        document.getElementById('aiSearchBtn').addEventListener('click', async function() {
            const query = document.getElementById('aiSearchInput').value;
            
            console.log("Кнопка нажата, запрос:", query);
            
            if (!query.trim()) {
                showCustomAlert();
                return;
            }
            
            document.getElementById('aiSearchLoading').style.display = 'block';
            document.getElementById('aiSearchBtn').disabled = true;
            
            try {
                const response = await fetch('/User/AISearch', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ query: query })
                });
                
                console.log("Статус ответа:", response.status);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error("Ошибка сервера:", errorText);
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const cars = await response.json();
                console.log("Получено автомобилей:", cars.length);
                
                saveLastSearch(query, cars);
                updateCarsList(cars);
                
                if (cars.length > 0) {
                    document.getElementById('resetSearchContainer').style.display = 'block';
                } else {
                    document.getElementById('resetSearchContainer').style.display = 'block';
                }
                
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при поиске. Подробности в консоли (F12)');
            } finally {
                document.getElementById('aiSearchLoading').style.display = 'none';
                document.getElementById('aiSearchBtn').disabled = false;
            }
        });
        
        document.getElementById('resetSearchBtn')?.addEventListener('click', function() {
            clearSavedSearch();
            location.reload();
        });
        
        document.getElementById('voiceSearchBtn')?.addEventListener('click', function() {
            startListening();
        });
        
        function updateCarsList(cars) {
            const container = document.getElementById('carsContainer');
            if (!container) return;
            
            if (!cars || cars.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5 nothing-found">
                        <i class="bi bi-search" style="font-size: 4rem; opacity: 0.7; color: #ffffff;"></i>
                        <h3 class="mt-3">Ничего не найдено</h3>
                        <p class="text-muted">По вашему запросу автомобили не найдены.</p>
                    </div>
                `;
                return;
            }
            
            let html = `<div class="cars-grid" id="carsGrid">`;
            cars.forEach(car => {
                const imagePath = car.imagePath || '';
                const categoryName = car.categoryName || 'Без категории';
                
                html += `
                    <div class="car-card" data-car-id="${car.id}">
                        ${imagePath ? 
                            `<img src="${imagePath}" class="card-img-top" alt="${car.brand} ${car.model}">` :
                            `<div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #3498db, #2980b9); height: 200px;">
                                <i class="bi bi-car-front" style="font-size: 4rem; color: white;"></i>
                            </div>`
                        }
                        <div class="card-body">
                            <h4>${escapeHtml(car.brand)} ${escapeHtml(car.model)}</h4>
                            <p class="text-muted">
                                <i class="bi bi-calendar"></i> ${car.year} г. |
                                <i class="bi bi-tag"></i> ${escapeHtml(categoryName)}
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="price">
                                    ${parseFloat(car.dailyPrice).toFixed(2)} BYN <span class="small fw-normal">/ день</span>
                                </div>
                                <a href="/User/Details/${car.id}" class="btn btn-primary">
                                    Подробнее <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                `;
            });
            html += `</div>`;
            container.innerHTML = html;
        }
        
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }
        
        // При загрузке страницы проверяем поддержку голосового поиска
        document.addEventListener('DOMContentLoaded', function() {
            restoreLastSearch();
            
            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
                const micBtn = document.getElementById('voiceSearchBtn');
                if (micBtn) {
                    micBtn.style.opacity = '0.5';
                    micBtn.title = "Голосовой поиск не поддерживается вашим браузером";
                    micBtn.addEventListener('click', function() {
                        showBrowserSupportModal();
                    });
                }
            }
        });
    </script>
}
