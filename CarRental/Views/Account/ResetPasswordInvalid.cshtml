@{
    ViewData["Title"] = "Ссылка недействительна";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container" style="max-width: 500px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: #e74c3c;"></i>
            </div>
            <h3>Ссылка недействительна</h3>
            <p class="text-muted">@ViewBag.Error</p>
            
            <a href="/Account/ForgotPassword" class="btn btn-primary mt-3">
                <i class="bi bi-envelope"></i> Запросить новую ссылку
            </a>
        </div>
    </div>
</div>