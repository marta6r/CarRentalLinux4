@model CarRental.Models.Customer

@{
    ViewData["Title"] = "Результаты поиска";
}

<div class="container mt-4">
    <h2><i class="bi bi-person-check"></i> @ViewData["Title"]</h2>
    <hr />

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ФИО:</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Телефон:</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Номер паспорта:</dt>
                <dd class="col-sm-9">@Model.PassportNumber</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Search" class="btn btn-outline-primary">
            <i class="bi bi-search"></i> Новый поиск
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-list-ul"></i> К списку клиентов
        </a>
    </div>
</div>
