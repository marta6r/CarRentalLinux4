@{
    ViewData["Title"] = "Забыли пароль?";
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
}

<div class="container" style="max-width: 500px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-question-circle" style="font-size: 3rem; color: #e74c3c;"></i>
                <h2 class="mt-2">Забыли пароль?</h2>
                <p class="text-muted">Введите ваш email и мы отправим ссылку для сброса пароля</p>
            </div>
            
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                </div>
            }
            
            <form method="post" asp-action="AdminForgotPassword" asp-controller="Account" autocomplete="off">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" id="email" class="form-control" 
                           placeholder="admin@carrental.by" 
                           autocomplete="off"
                           required />
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill">
                    <i class="bi bi-envelope"></i> Отправить ссылку
                </button>
            </form>
            
            <div class="mt-3 text-center">
                <a href="/Account/AdminLogin">Вернуться ко входу</a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
    }
    
    body.dark-mode .card {
        background: rgba(45, 45, 45, 0.95);
    }
    
    .form-control:focus {
        border-color: #e74c3c;
        box-shadow: 0 0 0 0.2rem rgba(231, 76, 60, 0.25);
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(231, 76, 60, 0.4);
    }
</style>