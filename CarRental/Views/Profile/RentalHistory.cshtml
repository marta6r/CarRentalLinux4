@model IEnumerable<CarRental.Models.Rental>

@{
    ViewData["Title"] = "История аренд";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-clock-history"></i> История аренд
        </h1>
        <p class="text-muted">Завершённые аренды автомобилей</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover custom-table">
                <thead>
                    <tr>
                        <th>Автомобиль</th>
                        <th>Дата начала</th>
                        <th>Дата возврата</th>
                        <th>Стоимость</th>
                        <th class="text-center">Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        <tr class="rental-row">
                            <td class="car-cell">
                                <div class="car-info">
                                    <i class="bi bi-car-front car-icon"></i>
                                    <div class="car-details">
                                        <strong class="car-name">@rental.Car?.Brand @rental.Car?.Model</strong><br />
                                        <small class="car-year">@rental.Car?.Year г.</small>
                                    </div>
                                </div>
                             </td>
                            <td class="date-cell">
                                <i class="bi bi-calendar3"></i>
                                @rental.RentDate.ToString("dd.MM.yyyy")
                             </td>
                            <td class="date-cell">
                                <i class="bi bi-calendar3"></i>
                                @rental.ReturnDate.ToString("dd.MM.yyyy")
                             </td>
                            <td class="price-cell">
                                <span class="price-badge">@rental.TotalPrice.ToString("N2") BYN</span>
                             </td>
                            <td class="status-cell text-center">
                                <span class="status-badge status-completed">
                                    <i class="bi bi-check-circle"></i> Завершена
                                </span>
                             </td>
                         </tr>
                    }
                </tbody>
             </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 empty-state">
            <i class="bi bi-clock-history empty-icon"></i>
            <h3 class="mt-3">У вас нет завершённых аренд</h3>
            <p>После завершения аренды они появятся здесь</p>
            <a href="/User/Index" class="btn btn-primary rounded-pill mt-3">
                <i class="bi bi-car-front"></i> Выбрать автомобиль
            </a>
        </div>
    }
</div>

<style>
    /* Общие стили */
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header {
        background: rgba(30, 30, 35, 0.95);
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: #ffffff;
    }

    .page-header h1 i {
        color: #3498db;
    }

    /* Кастомная таблица */
    .custom-table {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        backdrop-filter: blur(5px);
        transition: all 0.3s ease;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

    body.dark-mode .custom-table {
        background: rgba(30, 30, 35, 0.95);
        color: #e0e0e0;
    }

    /* Стили для шапки таблицы - НАСЫЩЕННЫЙ ГОЛУБОЙ */
    .custom-table thead tr {
        background: linear-gradient(135deg, #42a5f5, #1e88e5);
    }
    
    .custom-table thead th {
        color: white !important;
        font-weight: 700;
        padding: 1.2rem 1rem;
        font-size: 1.05rem;
        letter-spacing: 0.5px;
        border-bottom: none;
        background: transparent;
        font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
        text-shadow: 1px 1px 1px rgba(0,0,0,0.1);
    }

    /* Стили для шапки таблицы - ТЕМНАЯ ТЕМА */
    body.dark-mode .custom-table thead tr {
        background: linear-gradient(135deg, #1565c0, #0d47a1);
    }
    
    body.dark-mode .custom-table thead th {
        color: white !important;
        text-shadow: 1px 1px 1px rgba(0,0,0,0.2);
    }

    .custom-table tbody tr {
        transition: all 0.3s ease;
        border-bottom: 1px solid #f0f0f0;
    }

    body.dark-mode .custom-table tbody tr {
        border-bottom: 1px solid #3a3a3a;
    }

    .custom-table tbody tr:hover {
        background: rgba(66, 165, 245, 0.1);
    }

    body.dark-mode .custom-table tbody tr:hover {
        background: rgba(66, 165, 245, 0.15);
    }

    /* Ячейки */
    .car-cell {
        padding: 1rem !important;
    }

    .car-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .car-icon {
        font-size: 1.6rem;
        color: #1976d2;
        background: rgba(25, 118, 210, 0.1);
        padding: 0.5rem;
        border-radius: 12px;
    }

    body.dark-mode .car-icon {
        background: rgba(66, 165, 245, 0.15);
        color: #64b5f6;
    }

    .car-name {
        color: #212529;
        font-weight: 600;
        font-size: 1rem;
    }

    body.dark-mode .car-name {
        color: #ffffff !important;
    }

    .car-year {
        color: #6c757d;
        font-size: 0.85rem;
    }

    body.dark-mode .car-year {
        color: #b0b0b0;
    }

    .date-cell {
        vertical-align: middle !important;
        font-size: 0.95rem;
        color: #495057;
        font-weight: 500;
    }

    body.dark-mode .date-cell {
        color: #d0d0d0;
    }

    .date-cell i {
        margin-right: 0.5rem;
        color: #1976d2;
        font-size: 0.95rem;
    }

    body.dark-mode .date-cell i {
        color: #64b5f6;
    }

    .price-cell {
        vertical-align: middle !important;
    }

    .price-badge {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.95rem;
        display: inline-block;
        white-space: nowrap;
    }

    body.dark-mode .price-badge {
        background: #1b5e20;
        color: #a5d6a7;
    }

    /* Ячейка статуса - центрирование */
    .status-cell {
        vertical-align: middle !important;
        text-align: center !important;
    }

    /* Бейджи статуса */
    .status-badge {
        padding: 0.35rem 0.8rem;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        white-space: nowrap;
    }

    .status-badge i {
        font-size: 0.85rem;
    }

    .status-completed {
        background: #f5f5f5;
        color: #616161;
    }

    body.dark-mode .status-completed {
        background: #424242;
        color: #bdbdbd;
    }

    /* Пустое состояние */
    .empty-state {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        text-align: center;
    }

    body.dark-mode .empty-state {
        background: rgba(30, 30, 35, 0.95);
    }

    .empty-icon {
        font-size: 4rem;
        opacity: 0.7;
        color: #3498db;
    }

    .empty-state h3 {
        margin-top: 1rem;
        color: #2c3e50;
    }

    body.dark-mode .empty-state h3 {
        color: #ffffff;
    }

    .empty-state p {
        color: #6c757d;
    }

    body.dark-mode .empty-state p {
        color: #b0b0b0;
    }

    /* Вспомогательные классы */
    .text-center {
        text-align: center !important;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .custom-table thead th {
            font-size: 0.85rem;
            padding: 0.9rem 0.5rem;
        }
        
        .custom-table tbody td {
            padding: 0.75rem 0.5rem;
            font-size: 0.85rem;
        }
        
        .car-info {
            flex-direction: column;
            text-align: center;
        }
        
        .price-badge, .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }
        
        .date-cell i {
            display: none;
        }
        
        .car-name {
            font-size: 0.9rem;
        }
        
        .status-badge i {
            display: none;
        }
    }

    /* Анимации */
    .rental-row {
        animation: fadeInUp 0.5s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Скроллбар для таблицы */
    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.1);
        border-radius: 10px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #1e88e5;
        border-radius: 10px;
    }

    body.dark-mode .table-responsive::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.1);
    }
</style>