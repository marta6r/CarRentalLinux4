@model CarRental.Models.Customer

@{
    ViewData["Title"] = "Личный кабинет";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-person-circle"></i> Личный кабинет
        </h1>
        <p class="welcome-text">Добро пожаловать в ваш личный кабинет</p>
    </div>

    <div class="row">
        <!-- Карточка профиля с фото -->
        <div class="col-md-4 mb-4">
            <div class="card profile-card text-center">
                <div class="card-body">
                    <div class="profile-photo-wrapper">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Model.ImagePath" alt="Фото профиля" class="profile-photo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="profile-photo-placeholder" style="display: none;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                        else
                        {
                            <div class="profile-photo-placeholder">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                    </div>
                    <h4 class="mt-3 profile-name">@Model.FullName</h4>
                    <p class="profile-email">@Model.Email</p>
                    <span class="role-badge">
                        <i class="bi bi-shield-check"></i> @(Model.Role == "admin" ? "Администратор" : "Клиент")
                    </span>
                </div>
                <div class="card-footer bg-transparent">
                    <small class="text-muted">Зарегистрирован в системе</small>
                </div>
            </div>
        </div>

        <!-- Информация о пользователе -->
        <div class="col-md-8">
            <div class="card info-card">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle"></i> Мои данные</h5>
                </div>
                <div class="card-body">
                    <div class="info-table">
                        <div class="info-row">
                            <div class="info-label">
                                <i class="bi bi-person"></i>
                                <span>ФИО:</span>
                            </div>
                            <div class="info-value">@Model.FullName</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">
                                <i class="bi bi-envelope"></i>
                                <span>Email:</span>
                            </div>
                            <div class="info-value">@Model.Email</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">
                                <i class="bi bi-telephone"></i>
                                <span>Телефон:</span>
                            </div>
                            <div class="info-value">@Model.Phone</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">
                                <i class="bi bi-card-id"></i>
                                <span>Паспорт:</span>
                            </div>
                            <div class="info-value">@Model.PassportNumber</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Общие стили для страницы */
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: #3498db;
    }

    .welcome-text {
        color: #6c757d;
        margin-top: 0.5rem;
        margin-bottom: 0;
    }

    body.dark-mode .welcome-text {
        color: #adb5bd;
    }

    /* Карточка профиля */
    .profile-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .profile-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    body.dark-mode .profile-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .profile-photo-wrapper {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #3498db;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        background: #f8f9fa;
    }

    .profile-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-photo-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .profile-photo-placeholder i {
        font-size: 5rem;
        color: white;
    }

    .profile-name {
        color: #2c3e50;
        font-weight: 700;
    }

    body.dark-mode .profile-name {
        color: white;
    }

    .profile-email {
        color: #6c757d;
        margin-bottom: 1rem;
    }

    body.dark-mode .profile-email {
        color: #adb5bd;
    }

    .role-badge {
        display: inline-block;
        padding: 0.25rem 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    /* Информационная карточка */
    .info-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        overflow: hidden;
    }

    body.dark-mode .info-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .info-card .card-header {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        border: none;
        padding: 1rem 1.5rem;
    }

    .info-card .card-header h5 {
        margin: 0;
        font-weight: 600;
    }

    .info-card .card-header h5 i {
        margin-right: 0.5rem;
    }

    .info-table {
        padding: 0.5rem 0;
    }

    .info-row {
        display: flex;
        padding: 1rem;
        border-bottom: 1px solid #e9ecef;
        transition: background 0.2s ease;
    }

    .info-row:hover {
        background: rgba(52, 152, 219, 0.05);
    }

    body.dark-mode .info-row {
        border-bottom-color: #555;
    }

    .info-label {
        width: 150px;
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .info-label {
        color: #ecf0f1;
    }

    .info-label i {
        color: #3498db;
        font-size: 1.1rem;
    }

    .info-value {
        flex: 1;
        color: #555;
    }

    body.dark-mode .info-value {
        color: #ddd;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .info-row {
            flex-direction: column;
            gap: 0.5rem;
        }

        .info-label {
            width: 100%;
        }
    }
</style>