@{
    ViewData["Title"] = "Вход для администратора";
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
}

<div class="container" style="max-width: 500px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock-fill" style="font-size: 3rem; color: #e74c3c;"></i>
                <h2 class="mt-2">Вход для администратора</h2>
                <p class="text-muted">Введите ваши данные для входа в панель управления</p>
            </div>
            
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                </div>
            }
            
            <form method="post" asp-action="AdminLogin" asp-controller="Account" autocomplete="off">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label class="form-label">Email или телефон</label>
                    <input type="text" name="login" id="login" class="form-control" 
                           placeholder="admin@carrental.by или +375291234567" 
                           autocomplete="off" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <div class="input-group">
                        <input type="password" name="password" id="password" class="form-control" 
                               placeholder="Введите пароль" required />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()">
                            <i class="bi bi-eye-slash" id="passwordIcon"></i>
                        </button>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-danger w-100 py-2 rounded-pill">
                    <i class="bi bi-box-arrow-in-right"></i> Войти в панель управления
                </button>
            </form>
            
            <div class="mt-3 text-center">
                @* <a href="/Account/ForgotPassword" class="text-decoration-none">
                    <i class="bi bi-question-circle"></i> Забыли пароль?
                </a> *@
                <a href="/Account/AdminForgotPassword" class="text-decoration-none">
                    <i class="bi bi-question-circle"></i> Забыли пароль?
                </a>
            </div>
            
            <hr class="my-4">
            
            <div class="text-center">
                <a href="/Account/Login" class="text-decoration-none">
                    <i class="bi bi-person"></i> Вернуться к пользовательскому входу
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        const passwordField = document.getElementById('password');
        const icon = document.getElementById('passwordIcon');
        
        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        } else {
            passwordField.type = 'password';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        }
    }
    
    // Автофокус на поле логина
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('login').focus();
    });
</script>

<style>
    .card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
    }
    
    body.dark-mode .card {
        background: rgba(45, 45, 45, 0.95);
    }
    
    .form-control:focus {
        border-color: #e74c3c;
        box-shadow: 0 0 0 0.2rem rgba(231, 76, 60, 0.25);
    }
    
    .btn-danger {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(231, 76, 60, 0.4);
    }
    
    .alert {
        border-radius: 12px;
        border: none;
    }
    
    hr {
        border-color: #dee2e6;
    }
    
    body.dark-mode hr {
        border-color: #555;
    }
    
    a {
        color: #e74c3c;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    
    a:hover {
        color: #c0392b;
        text-decoration: underline;
    }
    
    @@media (max-width: 576px) {
        .card-body {
            padding: 1.5rem !important;
        }
    }
</style>