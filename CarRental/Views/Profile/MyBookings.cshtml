@model IEnumerable<CarRental.Models.Rental>

@{
    ViewData["Title"] = "Мои бронирования";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-calendar-check"></i> Мои бронирования
        </h1>
        
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover custom-table">
                <thead>
                    <tr>
                        <th>Автомобиль</th>
                        <th>Дата начала</th>
                        <th>Дата возврата</th>
                        <th>Стоимость</th>
                        <th class="text-center">Статус</th>
                        <th class="text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        var status = GetRentalStatus(rental.RentDate, rental.ReturnDate);
                        var statusClass = status switch
                        {
                            "Активно" => "status-active",
                            "Завершено" => "status-completed",
                            "Скоро" => "status-upcoming",
                            _ => ""
                        };
                        
                        <tr class="rental-row">
                            <td class="car-cell">
                                <div class="car-info">
                                    <i class="bi bi-car-front car-icon"></i>
                                    <div class="car-details">
                                        <strong class="car-name">@rental.Car?.Brand @rental.Car?.Model</strong><br />
                                        <small class="car-year">@rental.Car?.Year г.</small>
                                    </div>
                                </div>
                            </td>
                            <td class="date-cell">
                                <i class="bi bi-calendar3"></i>
                                @rental.RentDate.ToString("dd.MM.yyyy")
                            </td>
                            <td class="date-cell">
                                <i class="bi bi-calendar3"></i>
                                @rental.ReturnDate.ToString("dd.MM.yyyy")
                            </td>
                            <td class="price-cell">
                                <span class="price-badge">@rental.TotalPrice.ToString("N2") BYN</span>
                            </td>
                            <td class="status-cell text-center">
                                <span class="status-badge @statusClass">@status</span>
                            </td>
                            
                            <td class="action-cell text-center">
                                <a href="@Url.Action("RentalDetails", "User", new { id = rental.Id })" class="btn-details">
                                    <i class="bi bi-info-circle"></i> Подробнее
                                </a>
                            </td>






                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 empty-state">
            <i class="bi bi-calendar-x empty-icon"></i>
            <h3 class="mt-3">У вас нет активных бронирований</h3>
            <p>Забронируйте автомобиль, чтобы он появился здесь</p>
            <a href="/User/Index" class="btn btn-primary rounded-pill mt-3">
                <i class="bi bi-car-front"></i> Выбрать автомобиль
            </a>
        </div>
    }
</div>

<!-- Простое модальное окно на чистом CSS -->
<div id="rentalModal" class="modal-overlay" style="display: none;">
    <div class="modal-container">
        <div class="modal-header-custom">
            <h5 class="modal-title-custom">
                <i class="bi bi-file-text"></i> Детали аренды
            </h5>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-body-custom" id="rentalDetailsContent">
            <div class="text-center py-4">
                <div class="spinner"></div>
                <p class="mt-2">Загрузка информации...</p>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetRentalStatus(DateTime rentDate, DateTime returnDate)
    {
        var now = DateTime.Now;
        if (now >= rentDate && now <= returnDate)
            return "Активно";
        if (now < rentDate)
            return "Скоро";
        return "Завершено";
    }
}

<style>
