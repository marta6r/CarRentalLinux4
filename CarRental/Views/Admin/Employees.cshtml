@model IEnumerable<CarRental.Models.Customer>

@{
    ViewData["Title"] = "Сотрудники";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-people-fill"></i> Сотрудники
        </h1>
        <p class="text-muted">Управление персоналом компании</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-4">
        <a href="/Admin/CreateEmployee" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Добавить сотрудника
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-custom">
            <thead>
                <tr>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-person-badge me-1"></i> ФИО</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-envelope me-1"></i> Email</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-telephone me-1"></i> Телефон</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-card-text me-1"></i> Паспорт</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-shield-check me-1"></i> Должность</th>
                    <th style="background: #e74c3c; color: white; text-align: center;"><i class="bi bi-gear me-1"></i> Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr class="employee-row" data-employee-id="@employee.Id" data-employee-name="@employee.FullName">
                        <td class="fw-semibold" style="text-align: center;">@employee.FullName</td>
                        <td style="text-align: center;">@employee.Email</td>
                        <td style="text-align: center;">@employee.Phone</td>
                        <td style="text-align: center;">@employee.PassportNumber</td>
                        <td style="text-align: center;">
                            @if (employee.Role == "admin")
                            {
                                <span class="badge-admin">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Администратор
                                </span>
                            }
                            else
                            {
                                <span class="badge-manager">
                                    <i class="bi bi-person-badge-fill me-1"></i> Менеджер
                                </span>
                            }
                        </td>
                        <td style="text-align: center;">
                            @if (employee.Role != "admin")
                            {
                                <button type="button" class="btn-delete" onclick="showDeleteModal(@employee.Id, '@employee.FullName')">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted" style="cursor: not-allowed;">
                                    <i class="bi bi-lock-fill me-1"></i> Нельзя удалить
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<div id="deleteModal" class="modal-overlay" style="display: none;">
    <div class="modal-container">
        <div class="modal-header-custom">
            <h5 class="modal-title-custom">
                <i class="bi bi-exclamation-triangle-fill"></i> Подтверждение удаления
            </h5>
            <button class="modal-close" onclick="closeDeleteModal()">&times;</button>
        </div>
        <div class="modal-body-custom">
            <div class="text-center mb-3">
                <i class="bi bi-person-x-fill" style="font-size: 4rem; color: #e74c3c;"></i>
            </div>
            <p class="text-center" style="font-size: 1.1rem;">
                Вы действительно хотите удалить сотрудника?
            </p>
            <p class="text-center fw-bold" id="employeeNameToDelete" style="color: #e74c3c; font-size: 1.2rem;">
                
            </p>
            <p class="text-muted text-center">
                Это действие невозможно отменить.
            </p>
        </div>
        <div class="modal-footer-custom">
            <button type="button" class="btn-cancel" onclick="closeDeleteModal()">
                <i class="bi bi-x-circle"></i> Отмена
            </button>
            <form id="deleteEmployeeForm" method="post" style="display: inline;">
                <button type="submit" class="btn-confirm-delete">
                    <i class="bi bi-trash3-fill"></i> Удалить
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    let currentDeleteId = null;

    function showDeleteModal(id, fullName) {
        currentDeleteId = id;
        document.getElementById('employeeNameToDelete').innerText = fullName;
        
        const form = document.getElementById('deleteEmployeeForm');
        form.action = `/Admin/DeleteEmployee/${id}`;
        
        document.getElementById('deleteModal').style.display = 'flex';
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
        currentDeleteId = null;
    }

    // Закрытие по клику на фон
    document.getElementById('deleteModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeDeleteModal();
        }
    });

    // Закрытие по Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeDeleteModal();
        }
    });
</script>

