<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarRental</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            @* background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                              url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
             *@

            background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                          url('https://avatars.mds.yandex.net/get-altay/16430504/2a000001992a4d449da6e07938f4ba82eba3/orig'); 
   
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
        }

        body.dark-mode {
            @* background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), 
                              url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
         *@

         background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                          url('https://avatars.mds.yandex.net/get-altay/16430504/2a000001992a4d449da6e07938f4ba82eba3/orig'); 
   
        }

        /* Шапка */
        .navbar-custom {
            background: linear-gradient(135deg, rgba(44, 62, 80, 0.95), rgba(52, 152, 219, 0.95));
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            width: 100%;
        }

        body.dark-mode .navbar-custom {
            background: linear-gradient(135deg, rgba(30, 43, 58, 0.95), rgba(44, 62, 80, 0.95));
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 700;
            color: white;
            text-decoration: none;
        }

        .navbar-brand:hover {
            color: white;
        }

        .nav-link {
            font-size: 1.1rem;
            padding: 0.5rem 1rem !important;
            transition: all 0.3s ease;
            color: rgba(255, 255, 255, 0.9) !important;
            text-decoration: none;
        }

        .nav-link:hover {
            transform: translateY(-2px);
            color: white !important;
        }

        /* Переключатель темы */
        .theme-switch {
            margin-left: 1rem;
        }

        .form-switch .form-check-input {
            width: 3rem;
            height: 1.5rem;
            cursor: pointer;
        }

        .form-switch .form-check-input:checked {
            background-color: #3498db;
            border-color: #3498db;
        }

        /* Основной контент */
        main {
            flex: 1;
            padding: 2rem 1rem;
        }

        footer {
            background: rgba(44, 62, 80, 0.95);
            backdrop-filter: blur(10px);
            color: white;
            padding: 1rem 0;
            text-align: center;
            width: 100%;
        }
    </style>
</head>
<body>
    <!-- Шапка с логотипом и Главной -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-car-front-fill me-2"></i>CarRental
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">
                                <i class="bi bi-house-door me-1"></i>Главная
                            </a>
                        </li>
                    </ul>
                    <!-- Переключатель темы справа -->
                    <div class="theme-switch">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="darkModeSwitch">
                            <label class="form-check-label text-white" for="darkModeSwitch">
                                <i class="bi bi-moon-stars fs-5" id="themeIcon"></i>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container-fluid px-4 px-lg-5">
            <p class="mb-0">&copy; 2026 CarRental - Система управления арендой автомобилей</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Скрипт для переключения темы -->
    <script>
        function applyTheme(isDark) {
            if (isDark) {
                document.body.classList.add('dark-mode');
            } else {
                document.body.classList.remove('dark-mode');
            }
            
            const themeIcon = document.getElementById('themeIcon');
            if (themeIcon) {
                if (isDark) {
                    themeIcon.classList.remove('bi-moon-stars');
                    themeIcon.classList.add('bi-sun');
                } else {
                    themeIcon.classList.remove('bi-sun');
                    themeIcon.classList.add('bi-moon-stars');
                }
            }
            
            localStorage.setItem('darkMode', isDark);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const darkModeSwitch = document.getElementById('darkModeSwitch');
            
            if (!darkModeSwitch) return;
            
            const savedTheme = localStorage.getItem('darkMode');
            const isDark = savedTheme === 'true';
            
            darkModeSwitch.checked = isDark;
            applyTheme(isDark);
            
            darkModeSwitch.addEventListener('change', function() {
                applyTheme(this.checked);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>