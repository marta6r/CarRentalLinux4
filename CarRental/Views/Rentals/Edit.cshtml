@model CarRental.Models.Rental
@using CarRental.Models

@{
    ViewData["Title"] = "Редактирование аренды";
    var allCars = ViewBag.AllCars as IEnumerable<Car> ?? new List<Car>();
}

<!-- Подключаем Flatpickr -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ru.js"></script>

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
        --primary-yellow: #f1c40f;
        --primary-orange: #f39c12;
    }

    body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: var(--primary-yellow);
    }

    .form-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .form-card {
        background: rgba(45, 45, 45, 0.95);
    }

    .card-header {
        background: linear-gradient(135deg, var(--primary-yellow), var(--primary-orange));
        padding: 1.5rem 2rem;
        border: none;
    }

    .card-header h4 {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .form-label {
        color: #f8f9fa;
    }

    .form-label i {
        color: var(--primary-yellow);
        font-size: 1.1rem;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid rgba(241, 196, 15, 0.2);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        color: #2c3e50;
        width: 100%;
    }

    body.dark-mode .form-control {
        background: rgba(60, 60, 60, 0.9);
        border-color: rgba(255, 255, 255, 0.1);
        color: white !important;
    }

    /* Дополнительные стили для полей в тёмной теме */
    body.dark-mode input.form-control,
    body.dark-mode select.form-control,
    body.dark-mode textarea.form-control,
    body.dark-mode .form-control {
        background: rgba(50, 50, 55, 0.95);
        border-color: rgba(241, 196, 15, 0.3);
        color: white !important;
    }

    body.dark-mode input.form-control:focus,
    body.dark-mode select.form-control:focus,
    body.dark-mode textarea.form-control:focus,
    body.dark-mode .form-control:focus {
        background: rgba(60, 60, 65, 0.98);
        border-color: var(--primary-yellow);
        box-shadow: 0 0 0 0.25rem rgba(241, 196, 15, 0.25);
        color: white !important;
    }

    /* Автокомплит в тёмной теме */
    body.dark-mode .autocomplete-suggestions {
        background: #2a2a2a;
        border-color: #555;
        color: white;
    }

    body.dark-mode .list-group-item {
        border-bottom-color: #444;
        color: #ddd;
    }

    body.dark-mode .list-group-item:hover {
        background: #3a3a3a;
        color: white;
    }

    body.dark-mode .list-group-item .text-muted {
        color: #aaa !important;
    }

    /* Плейсхолдер в тёмной теме */
    body.dark-mode .form-control::placeholder {
        color: #aaa !important;
    }

    /* Readonly поля в тёмной теме */
    body.dark-mode .form-control[readonly] {
        background: rgba(241, 196, 15, 0.1);
        color: #ddd !important;
    }

    .price-info {
        margin-top: 0.5rem;
        padding: 0.5rem 1rem;
        background: rgba(241, 196, 15, 0.05);
        border-radius: 8px;
        font-size: 0.9rem;
        color: var(--primary-orange);
    }

    .calculation-info {
        background: rgba(241, 196, 15, 0.05);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
        color: #2c3e50;
        border-left: 4px solid var(--primary-yellow);
    }

    body.dark-mode .calculation-info {
        background: rgba(241, 196, 15, 0.1);
        color: #f8f9fa;
    }

    .calculation-info strong {
        color: var(--primary-orange);
        font-size: 1rem;
    }

    .text-danger {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .validation-summary-errors {
        background: rgba(231, 76, 60, 0.1);
        border-left: 4px solid #e74c3c;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    #availabilityError {
        background: rgba(231, 76, 60, 0.1);
        border-left: 4px solid #e74c3c;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-top: 0.5rem;
        font-weight: 500;
    }

    .max-days-warning {
        background: rgba(241, 196, 15, 0.1);
        border-left: 4px solid #f1c40f;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-top: 0.5rem;
        font-size: 0.85rem;
    }

    .flatpickr-day.disabled,
    .flatpickr-day.disabled:hover {
        background: #e74c3c !important;
        color: white !important;
        text-decoration: line-through;
        opacity: 0.7;
        cursor: not-allowed;
    }

    body.dark-mode .flatpickr-day.disabled,
    body.dark-mode .flatpickr-day.disabled:hover {
        background: #c0392b !important;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-yellow), var(--primary-orange));
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(241, 196, 15, 0.4);
        color: white;
    }

    .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(149, 165, 166, 0.4);
        color: white;
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 1rem;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .d-md-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .me-md-2 {
            margin-right: 0 !important;
        }
    }
</style>

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-pencil-square"></i> @ViewData["Title"]
        </h1>
    </div>

    <div class="form-card">
        <div class="card-header">
            <h4>
                <i class="bi bi-pencil-square"></i> Редактирование аренды #@Model.Id
            </h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" id="editForm" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-car-front"></i> Автомобиль
                        </label>
                        <input type="text" class="form-control" id="carInput"
                               value="@($"{Model.Car?.Brand} {Model.Car?.Model} {Model.Car?.Year}")"
                               placeholder="Начните вводить марку или модель" autocomplete="off" required />
                        <div id="carSuggestions" class="autocomplete-suggestions"></div>
                        <input type="hidden" asp-for="CarId" id="carId" value="@Model.CarId" />
                        <input type="hidden" id="dailyPriceValue" value="@Model.Car?.DailyPrice" />
                        <div class="price-info">
                            <i class="bi bi-tag"></i> Цена за день: <strong><span id="dailyPrice">@Model.Car?.DailyPrice</span> BYN</strong>
                        </div>
                        <span asp-validation-for="CarId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-person-circle"></i> Клиент
                        </label>
                        <input type="text" class="form-control" id="clientInput"
                               value="@Model.Customer?.FullName" 
                               placeholder="Введите ФИО клиента" required />
                        <input type="hidden" asp-for="CustomerId" id="clientId" value="@Model.CustomerId" />
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="RentDate" class="form-label">
                            <i class="bi bi-calendar-start"></i> Дата начала
                        </label>
                        <input asp-for="RentDate" type="text" class="form-control" id="rentDate" placeholder="Выберите дату" readonly />
                        <span asp-validation-for="RentDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReturnDate" class="form-label">
                            <i class="bi bi-calendar-end"></i> Дата возврата
                        </label>
                        <input asp-for="ReturnDate" type="text" class="form-control" id="returnDate" placeholder="Выберите дату" readonly />
                        <span asp-validation-for="ReturnDate" class="text-danger"></span>
                        <div id="availabilityError" class="text-danger mt-2" style="display: none;"></div>
                        <div id="maxDaysWarning" class="max-days-warning" style="display: none;">
                            <i class="bi bi-exclamation-triangle-fill"></i> Максимальная продолжительность аренды — 365 дней (1 год)
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="TotalPrice" class="form-label">
                            <i class="bi bi-currency-exchange"></i> Общая стоимость
                        </label>
                        <input asp-for="TotalPrice" class="form-control" id="totalPrice"
                               type="number" step="1" min="0" readonly />
                        <span asp-validation-for="TotalPrice" class="text-danger"></span>
                        <div class="calculation-info mt-1">
                            <i class="bi bi-calculator"></i> Расчет: 
                            <span id="calcDays">0</span> дней × 
                            <span id="calcPrice">@Model.Car?.DailyPrice</span> BYN = 
                            <strong><span id="calcTotal">0</span> BYN</strong>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-secondary me-md-2">
                        <i class="bi bi-arrow-left"></i> Назад к списку
                    </a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="bi bi-save"></i> Сохранить изменения
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            var carsData = @Html.Raw(Json.Serialize(allCars.Select(c => new
            {
                id = c.Id,
                displayText = $"{c.Brand} {c.Model} {c.Year}",
                dailyPrice = c.DailyPrice
            })));

            var bookedDates = [];
            var startDatePicker = null;
            var endDatePicker = null;
            var selectedStartDate = null;
            var selectedEndDate = null;
            var currentCarId = $('#carId').val();
            var rentalId = $('#Id').val();

            function loadBookedDates(carId) {
                if (!carId) return;
                
                $.ajax({
                    url: '/Rentals/GetBookedDates',
                    data: { carId: carId },
                    success: function(data) {
                        bookedDates = data;
                        console.log('Загружены занятые даты:', bookedDates);
                        updateDatePickers();
                        checkAvailabilityAndPrice();
                    },
                    error: function(xhr, status, error) {
                        console.error('Ошибка загрузки занятых дат:', error);
                    }
                });
            }

            function initDatePickers() {
                var initialStartDate = $('#RentDate').val();
                var initialEndDate = $('#ReturnDate').val();

                startDatePicker = flatpickr("#rentDate", {
                    locale: "ru",
                    dateFormat: "Y-m-d",
                    minDate: "today",
                    disable: bookedDates,
                    defaultDate: initialStartDate,
                    onChange: function(selectedDates, dateStr, instance) {
                        if (selectedDates.length > 0) {
                            selectedStartDate = selectedDates[0];
                            $('#RentDate').val(dateStr);
                            
                            if (endDatePicker) {
                                var minEndDate = new Date(selectedDates[0]);
                                minEndDate.setDate(selectedDates[0].getDate() + 1);
                                endDatePicker.set('minDate', minEndDate);
                                endDatePicker.set('disable', bookedDates);
                            }
                            
                            if (selectedEndDate && selectedEndDate <= selectedDates[0]) {
                                endDatePicker.clear();
                                selectedEndDate = null;
                                $('#ReturnDate').val('');
                            }
                        } else {
                            selectedStartDate = null;
                        }
                        checkAvailabilityAndPrice();
                    }
                });

                endDatePicker = flatpickr("#returnDate", {
                    locale: "ru",
                    dateFormat: "Y-m-d",
                    minDate: "today",
                    disable: bookedDates,
                    defaultDate: initialEndDate,
                    onChange: function(selectedDates, dateStr, instance) {
                        if (selectedDates.length > 0) {
                            selectedEndDate = selectedDates[0];
                            $('#ReturnDate').val(dateStr);
                        } else {
                            selectedEndDate = null;
                        }
                        checkAvailabilityAndPrice();
                    }
                });

                if (initialStartDate) selectedStartDate = new Date(initialStartDate);
                if (initialEndDate) selectedEndDate = new Date(initialEndDate);
            }

            function updateDatePickers() {
                if (startDatePicker) {
                    startDatePicker.set('disable', bookedDates);
                    startDatePicker.set('minDate', 'today');
                }
                if (endDatePicker) {
                    endDatePicker.set('disable', bookedDates);
                }
            }

            function checkAvailabilityAndPrice() {
                if (!selectedStartDate || !selectedEndDate || !currentCarId) {
                    $("#submitBtn").prop('disabled', false);
                    $("#availabilityError").hide();
                    $("#maxDaysWarning").hide();
                    calculateTotal();
                    return;
                }
                
                if (selectedEndDate <= selectedStartDate) {
                    $("#submitBtn").prop('disabled', true);
                    $("#availabilityError").html('<i class="bi bi-exclamation-triangle-fill"></i> Дата возврата должна быть позже даты начала').show();
                    $("#maxDaysWarning").hide();
                    calculateTotal();
                    return;
                }
                
                var startDateStr = formatDate(selectedStartDate);
                var endDateStr = formatDate(selectedEndDate);
                var daysDiff = Math.ceil((selectedEndDate - selectedStartDate) / (1000 * 60 * 60 * 24));
                
                if (daysDiff > 365) {
                    $("#maxDaysWarning").show();
                    $("#availabilityError").hide();
                    $("#submitBtn").prop('disabled', true);
                    calculateTotal();
                    return;
                }
                
                $("#maxDaysWarning").hide();
                
                $.ajax({
                    url: '/Rentals/CheckCarAvailability',
                    data: {
                        carId: currentCarId,
                        rentDate: startDateStr,
                        returnDate: endDateStr,
                        excludeRentalId: rentalId
                    },
                    success: function(isAvailable) {
                        if (!isAvailable) {
                            $("#availabilityError").html('<i class="bi bi-exclamation-triangle-fill"></i> Этот автомобиль уже арендован на выбранные даты').show();
                            $("#submitBtn").prop('disabled', true);
                        } else {
                            $("#availabilityError").hide();
                            $("#submitBtn").prop('disabled', false);
                        }
                        calculateTotal();
                    },
                    error: function() {
                        $("#submitBtn").prop('disabled', true);
                        calculateTotal();
                    }
                });
            }

            function calculateTotal() {
                if (!selectedStartDate || !selectedEndDate) {
                    $('#totalPrice').val('0');
                    $('#calcDays').text('0');
                    $('#calcTotal').text('0');
                    return;
                }
                
                var daysDiff = Math.ceil((selectedEndDate - selectedStartDate) / (1000 * 60 * 60 * 24));
                var dailyPrice = parseFloat($('#dailyPriceValue').val()) || 0;
                
                if (daysDiff <= 0) {
                    $('#totalPrice').val('0');
                    $('#calcDays').text('0');
                    $('#calcTotal').text('0');
                    return;
                }
                
                if (daysDiff > 365) {
                    $('#totalPrice').val('0');
                    $('#calcDays').text(daysDiff);
                    $('#calcTotal').text('0');
                    return;
                }
                
                var total = Math.round(daysDiff * dailyPrice);
                $('#totalPrice').val(total);
                $('#calcDays').text(daysDiff);
                $('#calcTotal').text(total);
            }

            function formatDate(date) {
                var year = date.getFullYear();
                var month = String(date.getMonth() + 1).padStart(2, '0');
                var day = String(date.getDate()).padStart(2, '0');
                return year + '-' + month + '-' + day;
            }

            // Автодополнение для автомобилей
            $('#carInput').on('input', function() {
                var searchTerm = $(this).val().toLowerCase();
                var suggestions = $('#carSuggestions');
                suggestions.empty().hide();

                if (searchTerm.length < 1) return;

                var matches = carsData.filter(function(car) {
                    return car.displayText.toLowerCase().includes(searchTerm);
                });

                if (matches.length > 0) {
                    matches.forEach(function(car) {
                        suggestions.append(
                            '<div class="list-group-item" data-id="' + car.id + '" data-price="' + car.dailyPrice + '">' +
                            '<strong>' + car.displayText + '</strong><br>' +
                            '<small class="text-muted">' + car.dailyPrice + ' BYN/день</small>' +
                            '</div>'
                        );
                    });
                    suggestions.show();
                }
            });

            $(document).on('click', '#carSuggestions .list-group-item', function() {
                var carId = $(this).data('id');
                var carPrice = $(this).data('price');
                var carText = $(this).find('strong').text();

                $('#carInput').val(carText);
                $('#carId').val(carId);
                $('#dailyPriceValue').val(carPrice);
                $('#dailyPrice').text(carPrice);
                $('#calcPrice').text(carPrice);
                $('#carSuggestions').hide();

                currentCarId = carId;
                loadBookedDates(carId);
                if (!startDatePicker) {
                    initDatePickers();
                } else {
                    updateDatePickers();
                }
                checkAvailabilityAndPrice();
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#carInput, #carSuggestions').length) {
                    $('#carSuggestions').hide();
                }
            });

            $('#editForm').submit(function(e) {
                if (!$('#carId').val()) {
                    alert('Пожалуйста, выберите автомобиль из списка');
                    e.preventDefault();
                    return false;
                }

                if ($('#availabilityError').is(':visible')) {
                    alert('Нельзя сохранить изменения - автомобиль уже арендован на выбранные даты');
                    e.preventDefault();
                    return false;
                }

                if ($('#maxDaysWarning').is(':visible')) {
                    alert('Максимальная продолжительность аренды — 365 дней');
                    e.preventDefault();
                    return false;
                }

                if (!$('#rentDate').val() || !$('#returnDate').val()) {
                    alert('Пожалуйста, выберите даты аренды');
                    e.preventDefault();
                    return false;
                }

                var totalPrice = $('#totalPrice').val();
                $('#totalPrice').val(Math.round(totalPrice));
                
                return true;
            });

            if (currentCarId) {
                loadBookedDates(currentCarId);
            }
            initDatePickers();
            checkAvailabilityAndPrice();
        });
    </script>
}