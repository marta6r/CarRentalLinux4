<!-- Основной контент -->
<div class="container">
    <!-- Заголовок страницы -->
    <div class="page-header">
        <h1>
            <i class="bi bi-car-front"></i> @ViewData["Title"]
        </h1>
        <div class="d-flex gap-2">
            <span class="badge" style="background: linear-gradient(135deg, var(--primary-purple), #8e44ad); color: white; padding: 0.5rem 1rem; border-radius: 50px;">
                <i class="bi bi-bar-chart"></i> @Model.Count автомобилей
            </span>
        </div>
    </div>

    <!-- Карточка статистики -->
    <div class="stats-card">
        <div class="card-header">
            <h4>
                <i class="bi bi-bar-chart"></i> Аналитика аренд автомобилей
            </h4>
        </div>
        <div class="card-body">
            <!-- Фильтры -->
            <div class="filters-section">
                <form method="get" class="mb-0">
                    <div class="row align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">
                                <i class="bi bi-sort-numeric-up"></i> Количество:
                            </label>
                            <select name="top" class="form-select" onchange="this.form.submit()">
                                <option value="5" selected="@(ViewBag.TopCount == 5)">Топ 5 автомобилей</option>
                                <option value="10" selected="@(ViewBag.TopCount == 10)">Топ 10 автомобилей</option>
                                <option value="20" selected="@(ViewBag.TopCount == 20)">Топ 20 автомобилей</option>
                                <option value="50" selected="@(ViewBag.TopCount == 50)">Топ 50 автомобилей</option>
                                <option value="0" selected="@(ViewBag.TopCount == 0)">Все автомобили</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                <i class="bi bi-sort-alpha-down"></i> Сортировка:
                            </label>
                            <select name="sortBy" class="form-select" onchange="this.form.submit()">
                                <option value="count" selected="@(ViewBag.SortBy == "count" ? "selected" : null)">По количеству аренд</option>
                                <option value="revenue" selected="@(ViewBag.SortBy == "revenue" ? "selected" : null)">По доходу</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex gap-2">
                                <button class="btn btn-success flex-fill" id="downloadCsvBtn">
                                    <i class="bi bi-file-earmark-excel"></i> Экспорт CSV
                                </button>
                                <button class="btn btn-danger flex-fill" id="downloadPdfBtn">
                                    <i class="bi bi-file-earmark-pdf"></i> Экспорт PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- График -->
            <div class="chart-container">
                <canvas id="statsChart"></canvas>
            </div>

            <!-- Таблица -->
            <div class="table-container">
                <table class="table" id="statsTable">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">#</th>
                            <th>Автомобиль</th>
                            <th class="text-center">Аренды</th>
                            <th class="text-end">Доход (BYN)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var car = Model[i];
                            <tr>
                                <td class="text-center">
                                    <span class="rank-badge">@(i + 1)</span>
                                </td>
                                <td>
                                    <div class="car-info">
                                        <i class="bi bi-car-front"></i>
                                        <strong>@car.CarInfo</strong>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="stat-highlight">@car.RentalCount</span>
                                </td>
                                <td class="text-end">
                                    <span class="revenue-highlight">@car.TotalRevenue.ToString("N2")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Скрипт темной темы -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const darkModeSwitch = document.getElementById('darkModeSwitch');
        const themeIcon = darkModeSwitch.nextElementSibling.querySelector('i');
        
        const isDark = localStorage.getItem('darkMode') === 'true';
        if (isDark) {
            document.body.classList.add('dark-mode');
            darkModeSwitch.checked = true;
            themeIcon.classList.remove('bi-moon-stars');
            themeIcon.classList.add('bi-sun');
        }

        darkModeSwitch.addEventListener('change', function() {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('darkMode', this.checked);
            
            if (this.checked) {
                themeIcon.classList.remove('bi-moon-stars');
                themeIcon.classList.add('bi-sun');
            } else {
                themeIcon.classList.remove('bi-sun');
                themeIcon.classList.add('bi-moon-stars');
            }
        });
    });
</script>

@section Scripts {
    <!-- Подключаем библиотеки -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.19.3/package/dist/xlsx.full.min.js"></script>

    <script>
        // Инициализация после загрузки страницы
        document.addEventListener('DOMContentLoaded', function() {
            initChart();
            setupDownloadButtons();
        });

        // Инициализация графика
        function initChart() {
            const ctx = document.getElementById('statsChart');
            if (!ctx) return;

            const carNames = @Html.Raw(Json.Serialize(Model.Select(c => c.CarInfo)));
            const rentalCounts = @Html.Raw(Json.Serialize(Model.Select(c => c.RentalCount)));
            const revenues = @Html.Raw(Json.Serialize(Model.Select(c => c.TotalRevenue)));

            // Цвета для графика
            const backgroundColors = [];
            for (let i = 0; i < carNames.length; i++) {
                const hue = (i * 360 / carNames.length) % 360;
                backgroundColors.push(`hsla(${hue}, 70%, 50%, 0.7)`);
            }

            new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: carNames,
                    datasets: [{
                        label: 'Количество аренд',
                        data: rentalCounts,
                        backgroundColor: backgroundColors,
                        borderColor: backgroundColors.map(c => c.replace('0.7', '1')),
                        borderWidth: 1,
                        borderRadius: 5,
                        barPercentage: 0.6
                    }, {
                        label: 'Доход (BYN)',
                        data: revenues,
                        backgroundColor: backgroundColors.map(c => c.replace('0.7', '0.3')),
                        borderColor: backgroundColors.map(c => c.replace('0.7', '1')),
                        borderWidth: 1,
                        type: 'line',
                        yAxisID: 'y1',
                        tension: 0.4,
                        pointBackgroundColor: backgroundColors.map(c => c.replace('0.7', '1')),
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: {
                                    size: 12,
                                    weight: '500'
                                },
                                padding: 20
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0,0,0,0.8)',
                            titleFont: { size: 14, weight: 'bold' },
                            bodyFont: { size: 13 },
                            padding: 12,
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Количество аренд',
                                font: { size: 12, weight: '600' }
                            },
                            grid: {
                                color: 'rgba(0,0,0,0.05)'
                            }
                        },
                        y1: {
                            position: 'right',
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Доход (BYN)',
                                font: { size: 12, weight: '600' }
                            },
                            grid: {
                                drawOnChartArea: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        }
                    }
                }
            });
        }

        // Настройка кнопок скачивания
        function setupDownloadButtons() {
            document.getElementById('downloadCsvBtn').addEventListener('click', downloadCsv);
            document.getElementById('downloadPdfBtn').addEventListener('click', downloadPdf);
        }

        // Скачать CSV
        function downloadCsv() {
            try {
                const rows = Array.from(document.querySelectorAll('#statsTable tbody tr'));
                const csvContent = [
                    ['№', 'Автомобиль', 'Количество аренд', 'Доход (BYN)'],
                    ...rows.map(row => {
                        const cols = row.querySelectorAll('td');
                        return [
                            cols[0].textContent.trim(),
                            cols[1].textContent.trim(),
                            cols[2].textContent.trim(),
                            cols[3].textContent.trim()
                        ];
                    })
                ].map(e => e.join(',')).join('\n');

                const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `car_stats_${new Date().toISOString().slice(0,10)}.csv`;
                link.click();
            } catch (error) {
                console.error('CSV export error:', error);
                alert('Ошибка при создании CSV файла');
            }
        }

        // Скачать PDF
        function downloadPdf() {
            try {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('landscape');

                // Заголовок
                doc.setFontSize(18);
                doc.setTextColor(155, 89, 182);
                doc.text('Статистика по автомобилям', 14, 15);
                
                doc.setFontSize(10);
                doc.setTextColor(100, 100, 100);
                doc.text(`Дата генерации: ${new Date().toLocaleDateString('ru-RU')}`, 14, 22);
                doc.text(`Всего автомобилей: ${@Model.Count}`, 14, 28);

                // Таблица
                doc.autoTable({
                    head: [['№', 'Автомобиль', 'Количество аренд', 'Доход (BYN)']],
                    body: Array.from(document.querySelectorAll('#statsTable tbody tr')).map(row => {
                        const cols = row.querySelectorAll('td');
                        return [
                            cols[0].textContent.trim(),
                            cols[1].textContent.trim(),
                            cols[2].textContent.trim(),
                            cols[3].textContent.trim()
                        ];
                    }),
                    startY: 35,
                    styles: {
                        fontSize: 9,
                        cellPadding: 4,
                        font: 'helvetica'
                    },
                    headStyles: {
                        fillColor: [155, 89, 182],
                        textColor: 255,
                        fontStyle: 'bold',
                        halign: 'center'
                    },
                    columnStyles: {
                        0: { cellWidth: 20, halign: 'center' },
                        1: { cellWidth: 'auto' },
                        2: { cellWidth: 40, halign: 'center' },
                        3: { cellWidth: 50, halign: 'right' }
                    },
                    alternateRowStyles: {
                        fillColor: [245, 245, 245]
                    }
                });

                doc.save(`car_stats_${new Date().toISOString().slice(0,10)}.pdf`);
            } catch (error) {
                console.error('PDF export error:', error);
                alert('Ошибка при создании PDF файла');
            }
        }
    </script>
}  