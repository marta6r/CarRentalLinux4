@{
    ViewData["Title"] = "CarRental";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<link rel="stylesheet" href="~/css/main-home.css" />

<div class="hero-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="main-card p-5 text-center">
                    <!-- Анимированная иконка -->
                    <div class="car-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    
                    <!-- Заголовок -->
                    <h1 class="title">CarRental</h1>
                    <p class="subtitle">Система управления арендой автомобилей</p>
                    
                    <!-- Разделитель -->
                    <div class="d-flex justify-content-center my-4">
                        <div style="width: 80px; height: 3px; background: linear-gradient(90deg, #3498db, #2c3e50); border-radius: 3px;"></div>
                    </div>
                    
                    <!-- Кнопки выбора режима -->
                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                        <a href="/User/Index" class="btn btn-user btn-mode">
                            <i class="bi bi-person me-2"></i> Режим пользователя
                        </a>
                        <a href="/Cars" class="btn btn-admin btn-mode">
                            <i class="bi bi-shield-lock me-2"></i> Режим администратора
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>