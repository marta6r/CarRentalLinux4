        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header {
        background: rgba(30, 30, 35, 0.95);
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
