@model CarRental.Models.Customer

@{
    ViewData["Title"] = "Регистрация";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container" style="max-width: 600px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus" style="font-size: 3rem; color: #3498db;"></i>
                <h2 class="mt-2">Регистрация</h2>
            </div>
            
            <form method="post" autocomplete="off" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <div class="mb-3">
                    <label class="form-label">ФИО</label>
                    <input asp-for="FullName" class="form-control" 
                           autocomplete="off" 
                           autocorrect="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" 
                           autocomplete="off" 
                           autocorrect="off" 
                           autocapitalize="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Телефон</label>
                    <input asp-for="Phone" class="form-control" 
                           placeholder="+375XXXXXXXXX" 
                           autocomplete="off" 
                           autocorrect="off" 
                           autocapitalize="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Номер паспорта</label>
                    <input asp-for="PassportNumber" class="form-control" 
                           placeholder="AB1234567" 
                           autocomplete="off" 
                           autocorrect="off" 
                           spellcheck="false" 
                           required />
                    <span asp-validation-for="PassportNumber" class="text-danger"></span>
                </div>
                
                <!-- Поле для пароля -->
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" 
                               id="password" 
                               placeholder="Минимум 6 символов" 
                               autocomplete="new-password" 
                               required />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('password')">
                            <i class="bi bi-eye-slash" id="passwordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small class="text-muted">Пароль должен содержать минимум 6 символов</small>
                </div>
                
                <!-- Поле для подтверждения пароля -->
                <div class="mb-3">
                    <label class="form-label">Подтверждение пароля</label>
                    <div class="input-group">
                        <input type="password" name="ConfirmPassword" id="confirmPassword" 
                               class="form-control" 
                               placeholder="Повторите пароль" 
                               autocomplete="off" 
                               required />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('confirmPassword')">
                            <i class="bi bi-eye-slash" id="confirmPasswordIcon"></i>
                        </button>
                    </div>
                    <span class="text-danger">@ViewBag.PasswordMismatch</span>
                </div>
                
                <!-- Блок для загрузки фото клиента -->
                <div class="mb-4">
                    <label class="form-label">Фото клиента</label>
                    <div class="text-center mb-3" id="photoPreviewContainer" style="display: none;">
                        <img id="photoPreview" src="#" alt="Предпросмотр фото" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; border: 3px solid #3498db; padding: 3px;" />
                    </div>
                    <input type="file" name="CustomerPhoto" id="CustomerPhoto" 
                           class="form-control" 
                           accept="image/jpeg,image/png,image/jpg,image/gif"
                           style="padding: 8px;" />
                    <small class="text-muted">Поддерживаемые форматы: JPEG, PNG, JPG, GIF. Максимальный размер: 5MB</small>
                    <span id="photoError" class="text-danger" style="display: none;"></span>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill">
                    <i class="bi bi-check-lg"></i> Зарегистрироваться
                </button>
            </form>
            
            <p class="text-center mt-3">
                Уже есть аккаунт? <a href="/Account/Login">Войти</a>
            </p>
        </div>
    </div>
</div>

<script>
    // Функция для показа/скрытия пароля
    function togglePassword(fieldId) {
        const field = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + 'Icon');
        
        if (field.type === 'password') {
            field.type = 'text';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        } else {
            field.type = 'password';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        }
    }
    
    // Предпросмотр фото перед загрузкой
    document.getElementById('CustomerPhoto').addEventListener('change', function(event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById('photoPreviewContainer');
        const preview = document.getElementById('photoPreview');
        const photoError = document.getElementById('photoError');
        
        // Скрываем предыдущие ошибки
        photoError.style.display = 'none';
        
        if (file) {
            // Проверка размера файла (5MB = 5 * 1024 * 1024 байт)
            const maxSize = 5 * 1024 * 1024;
            if (file.size > maxSize) {
                photoError.textContent = 'Размер файла не должен превышать 5MB';
                photoError.style.display = 'block';
                event.target.value = ''; // Очищаем поле
                previewContainer.style.display = 'none';
                preview.src = '#';
                return;
            }
            
            // Проверка типа файла
            const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                photoError.textContent = 'Поддерживаются только изображения (JPEG, PNG, JPG, GIF)';
                photoError.style.display = 'block';
                event.target.value = ''; // Очищаем поле
                previewContainer.style.display = 'none';
                preview.src = '#';
                return;
            }
            
            // Показываем предпросмотр
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.style.display = 'none';
            preview.src = '#';
        }
    });
    
    // Валидация формы перед отправкой
    document.querySelector('form').addEventListener('submit', function(e) {
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        
        if (password !== confirmPassword) {
            e.preventDefault();
            alert('Пароли не совпадают!');
            return false;
        }
        
        if (password.length < 6) {
            e.preventDefault();
            alert('Пароль должен содержать минимум 6 символов!');
            return false;
        }
        
        return true;
    });
</script>

<style>
    /* Дополнительные стили для красивого отображения */
    input[type="file"] {
        cursor: pointer;
    }
    
    input[type="file"]:hover {
        background-color: #f8f9fa;
    }
    
    #photoPreview {
        transition: transform 0.3s ease;
    }
    
    #photoPreview:hover {
        transform: scale(1.05);
    }
    
    /* Стили для полей ввода */
    .form-control:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
    }
    
    /* Стили для кнопки показа пароля */
    .input-group .btn-outline-secondary {
        border-left: none;
    }
    
    .input-group .form-control:focus + .btn-outline-secondary {
        border-color: #3498db;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}