@model IEnumerable<CarRental.Models.Customer>

@{
    ViewData["Title"] = "Клиенты";
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
        --primary-green: #2ecc71;
        --primary-dark-green: #27ae60;
        --primary-blue: #3498db;
        --primary-red: #e74c3c;
    }

    body {
        @* background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920'); *@

        background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                          url('https://avatars.mds.yandex.net/get-altay/16430504/2a000001992a4d449da6e07938f4ba82eba3/orig'); 
  
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    body.dark-mode {
        @* background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
    *@

    background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                          url('https://avatars.mds.yandex.net/get-altay/16430504/2a000001992a4d449da6e07938f4ba82eba3/orig');
    
    }

    /* Шапка */
    .navbar-custom {
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.95), rgba(52, 152, 219, 0.95));
        backdrop-filter: blur(10px);
        padding: 1rem 0;
        margin-bottom: 2rem;
    }

    body.dark-mode .navbar-custom {
        background: linear-gradient(135deg, rgba(30, 43, 58, 0.95), rgba(44, 62, 80, 0.95));
    }

    /* Заголовок страницы */
    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    body.dark-mode .page-header {
        background: rgba(45, 45, 45, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: var(--primary-green);
    }

    /* Кнопки в шапке */
    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-green), var(--primary-dark-green));
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(46, 204, 113, 0.4);
        color: white;
    }

    .btn-info {
        background: linear-gradient(135deg, var(--primary-blue), #2980b9);
        color: white;
    }

    .btn-info:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(52, 152, 219, 0.4);
        color: white;
    }

    /* Сетка карточек */
    .customers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    /* Карточка клиента */
    .customer-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    body.dark-mode .customer-card {
        background: rgba(45, 45, 45, 0.95);
        border-color: rgba(255, 255, 255, 0.1);
    }

    .customer-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    /* Шапка карточки */
    .card-header {
        background: linear-gradient(135deg, var(--primary-green), var(--primary-dark-green));
        padding: 1.2rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border-bottom: none;
    }

    .customer-avatar {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

    .customer-avatar-placeholder {
        width: 60px;
        height: 60px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .customer-avatar-placeholder i {
        font-size: 2rem;
        color: white;
    }

    .card-header h3 {
        margin: 0;
        color: white;
        font-size: 1.2rem;
        font-weight: 600;
        line-height: 1.4;
    }

    .card-header small {
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.85rem;
        display: block;
        margin-top: 0.2rem;
    }

    /* Тело карточки */
    .card-body {
        padding: 1.5rem;
    }

    /* Информационные строки */
    .info-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    body.dark-mode .info-row {
        border-bottom-color: rgba(255, 255, 255, 0.05);
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-icon {
        width: 35px;
        height: 35px;
        background: rgba(46, 204, 113, 0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-green);
        font-size: 1.1rem;
    }

    body.dark-mode .info-icon {
        background: rgba(255, 255, 255, 0.1);
        color: var(--primary-green);
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        font-size: 0.75rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.2rem;
    }

    body.dark-mode .info-label {
        color: #adb5bd;
    }

    .info-value {
        color: #2c3e50;
        font-weight: 500;
        word-break: break-word;
    }

    body.dark-mode .info-value {
        color: #f8f9fa;
    }

    /* Паспорт */
    .passport-badge {
        background: rgba(52, 152, 219, 0.1);
        color: var(--primary-blue);
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .passport-badge {
        background: rgba(52, 152, 219, 0.2);
        color: #3498db;
    }

    /* Футер карточки */
    .card-footer {
        background: rgba(0, 0, 0, 0.02);
        padding: 1.2rem 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    body.dark-mode .card-footer {
        background: rgba(255, 255, 255, 0.02);
        border-top-color: rgba(255, 255, 255, 0.05);
    }

    /* Кнопки действий */
    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border: none;
        font-size: 1rem;
    }

    .action-btn:hover {
        transform: translateY(-2px);
    }

    .btn-edit {
        background: rgba(46, 204, 113, 0.1);
        color: var(--primary-green);
    }

    .btn-edit:hover {
        background: linear-gradient(135deg, var(--primary-green), var(--primary-dark-green));
        color: white;
        box-shadow: 0 5px 15px rgba(46, 204, 113, 0.4);
    }

    .btn-details {
        background: rgba(52, 152, 219, 0.1);
        color: var(--primary-blue);
    }

    .btn-details:hover {
        background: linear-gradient(135deg, var(--primary-blue), #2980b9);
        color: white;
        box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
    }

    .btn-delete {
        background: rgba(231, 76, 60, 0.1);
        color: var(--primary-red);
    }

    .btn-delete:hover {
        background: linear-gradient(135deg, var(--primary-red), #c0392b);
        color: white;
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
    }

    /* Пустое состояние */
    .empty-state {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 3rem;
        text-align: center;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .empty-state {
        background: rgba(45, 45, 45, 0.95);
    }

    .empty-state i {
        font-size: 4rem;
        color: var(--primary-green);
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .empty-state h3 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    body.dark-mode .empty-state h3 {
        color: white;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 1.5rem;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .customers-grid {
            grid-template-columns: 1fr;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .card-footer {
            flex-wrap: wrap;
        }
        
        .action-btn {
            flex: 1;
            width: auto;
        }
        
        .card-header {
            flex-wrap: wrap;
            justify-content: center;
            text-align: center;
        }
    }
</style>

<!-- Основной контент -->
<div class="container">
    <!-- Заголовок страницы -->
    <div class="page-header">
        <h1>
            <i class="bi bi-people-fill"></i> @ViewData["Title"]
        </h1>
        <div class="d-flex gap-2">
            <a asp-action="Search" class="btn btn-info">
                <i class="bi bi-search"></i> Поиск клиента
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Добавить клиента
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Сетка карточек -->
        <div class="customers-grid">
            @foreach (var item in Model)
            {
                <div class="customer-card">
                    <!-- Шапка карточки с ФИО и фото -->
                    <div class="card-header">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="@item.FullName" class="customer-avatar" />
                        }
                        else
                        {
                            <div class="customer-avatar-placeholder">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                        <div>
                            <h3>@item.FullName</h3>
                            <small>Клиент</small>
                        </div>
                    </div>

                    <!-- Тело карточки с информацией -->
                    <div class="card-body">
                        <!-- Email -->
                        <div class="info-row">
                            <div class="info-icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Email</div>
                                <div class="info-value">@item.Email</div>
                            </div>
                        </div>

                        <!-- Телефон -->
                        <div class="info-row">
                            <div class="info-icon">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Телефон</div>
                                <div class="info-value">@item.Phone</div>
                            </div>
                        </div>

                        <!-- Паспорт -->
                        <div class="info-row">
                            <div class="info-icon">
                                <i class="bi bi-card-text"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Номер паспорта</div>
                                <div class="info-value">
                                    <span class="passport-badge">
                                        <i class="bi bi-card-text me-1"></i>
                                        @item.PassportNumber
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Футер с кнопками действий -->
                    <div class="card-footer">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Редактировать">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-details" title="Подробнее">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Удалить">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Пустое состояние -->
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <h3>Клиенты не найдены</h3>
            <p>Добавьте нового клиента, чтобы начать работу</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Добавить клиента
            </a>
        </div>
    }
</div>