@model CarRental.Models.Rental

@{
    ViewData["Title"] = "Характеристики аренды";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["ActivePage"] = "MyBooking";
}

<style>
    :root {
        --text-light: #2c3e50;
        --text-dark: #f8f9fa;
        --text-muted-light: #6c757d;
        --text-muted-dark: #adb5bd;
    }

    body {
        background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    body.dark-mode {
        background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), 
                          url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1920');
    }

    .page-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .page-header {
        background: rgba(30, 30, 35, 0.95);
    }

    .page-header h1 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .page-header h1 {
        color: white;
    }

    .page-header h1 i {
        color: #f1c40f;
    }

    .details-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    body.dark-mode .details-card {
        background: rgba(30, 30, 35, 0.95);
    }

    .card-header {
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        padding: 1.5rem 2rem;
        border: none;
    }

    .card-header h4 {
        color: white;
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    /* Специальный контейнер для PDF (без кнопок) */
    #pdfContent {
        padding: 0;
        background: white;
    }

    /* PDF заголовок */
    .pdf-header {
        text-align: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #f1c40f;
    }

    .pdf-header h2 {
        color: #f1c40f;
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 0.3rem 0;
    }

    .pdf-header p {
        color: #6c757d;
        font-size: 0.8rem;
        margin: 0;
    }

    body.dark-mode .pdf-header p {
        color: #adb5bd;
    }

    .info-section {
        background: rgba(241, 196, 15, 0.03);
        border-radius: 15px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    body.dark-mode .info-section {
        background: rgba(255, 255, 255, 0.03);
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 2px solid rgba(241, 196, 15, 0.3);
        padding-bottom: 0.3rem;
    }

    body.dark-mode .section-title {
        color: #f8f9fa;
    }

    .section-title i {
        color: #f1c40f;
        font-size: 1rem;
    }

    .info-row {
        display: flex;
        margin-bottom: 0.5rem;
        padding: 0.3rem 0;
        border-bottom: 1px solid rgba(0,0,0,0.03);
    }

    body.dark-mode .info-row {
        border-bottom-color: rgba(255,255,255,0.03);
    }

    .info-label {
        width: 130px;
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
    }

    body.dark-mode .info-label {
        color: #f8f9fa;
    }

    .info-label i {
        color: #f1c40f;
        width: 18px;
        font-size: 0.85rem;
    }

    .info-value {
        flex: 1;
        color: #6c757d;
        font-size: 0.85rem;
    }

    body.dark-mode .info-value {
        color: #adb5bd;
    }

    .price-highlight {
        font-weight: 700;
        color: #f39c12;
        font-size: 1rem;
    }

    body.dark-mode .price-highlight {
        color: #f1c40f;
    }

    .duration-highlight {
        font-weight: 600;
        color: #3498db;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.6rem;
        border-radius: 50px;
        font-weight: 500;
        font-size: 0.75rem;
    }

    .badge.bg-success {
        background: linear-gradient(135deg, #2ecc71, #27ae60) !important;
        color: white;
    }

    .badge.bg-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d) !important;
        color: white;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(241, 196, 15, 0.4);
        color: white;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(149, 165, 166, 0.4);
        color: white;
    }

    .btn i {
        font-size: 1rem;
    }

    /* Контейнер для кнопок (не попадает в PDF) */
    .buttons-container {
        margin-top: 1.5rem;
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 1rem;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .info-row {
            flex-direction: column;
            gap: 0.2rem;
        }
        
        .info-label {
            width: 100%;
        }
        
        .btn {
            width: 100%;
            justify-content: center;
        }
        
        .buttons-container {
            flex-direction: column;
        }
        
        .pdf-header h2 {
            font-size: 1.2rem;
        }
    }
</style>

<div class="container">
    <div class="page-header">
        <h1>
            <i class="bi bi-file-text"></i> @ViewData["Title"]
        </h1>
    </div>

    <div class="details-card">
        <div class="card-header">
            <h4>
                <i class="bi bi-file-earmark-text"></i> Аренда #@Model.Id
            </h4>
        </div>
        <div class="card-body">
            <!-- Контент для PDF (без кнопок) -->
            <div id="pdfContent">
                <!-- Заголовок PDF -->
                <div class="pdf-header">
                    <h2>ЧЕК АРЕНДЫ АВТОМОБИЛЯ</h2>
                    <p>Аренда №@Model.Id</p>
                    @* <p>Дата создания: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p> *@
                </div>

                <div class="info-section">
                    <div class="section-title">
                        <i class="bi bi-car-front"></i> Информация об автомобиле
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-tag"></i> Марка</span>
                        <span class="info-value">@(Model.Car != null ? Model.Car.Brand : "Не указано")</span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-tag"></i> Модель</span>
                        <span class="info-value">@(Model.Car != null ? Model.Car.Model : "Не указано")</span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calendar"></i> Год выпуска</span>
                        <span class="info-value">@(Model.Car != null ? Model.Car.Year.ToString() : "Не указано")</span>
                    </div>
                    
                    @if (Model.Car != null)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-check-circle"></i> Статус авто</span>
                            <span class="info-value">
                                @if (Model.Car.IsAvailable)
                                {
                                    <span class="badge bg-success">Доступен</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Занят</span>
                                }
                            </span>
                        </div>
                    }
                </div>

                <div class="info-section">
                    <div class="section-title">
                        <i class="bi bi-person-circle"></i> Информация о клиенте
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-person-badge"></i> ФИО</span>
                        <span class="info-value">@(Model.Customer != null ? Model.Customer.FullName : "Не указано")</span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-telephone"></i> Телефон</span>
                        <span class="info-value">@(Model.Customer != null ? Model.Customer.Phone : "Не указано")</span>
                    </div>
                    
                    @if (Model.Customer != null)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-envelope"></i> Email</span>
                            <span class="info-value">@Model.Customer.Email</span>
                        </div>
                        
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-card-text"></i> Паспорт</span>
                            <span class="info-value">@Model.Customer.PassportNumber</span>
                        </div>
                    }
                </div>

                <div class="info-section">
                    <div class="section-title">
                        <i class="bi bi-calendar-check"></i> Детали аренды
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calendar-start"></i> Дата начала</span>
                        <span class="info-value">@Model.RentDate.ToString("dd.MM.yyyy")</span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calendar-end"></i> Дата возврата</span>
                        <span class="info-value">@Model.ReturnDate.ToString("dd.MM.yyyy")</span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-hourglass"></i> Длительность</span>
                        <span class="info-value">
                            <span class="duration-highlight">@((Model.ReturnDate - Model.RentDate).Days)</span> дней
                        </span>
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-info-circle"></i> Статус</span>
                        <span class="info-value">
                            @if (Model.ReturnDate >= DateTime.Now)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Активна
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-clock-history"></i> Завершена
                                </span>
                            }
                        </span>
                    </div>
                </div>

                <div class="info-section">
                    <div class="section-title">
                        <i class="bi bi-currency-exchange"></i> Финансовая информация
                    </div>
                    
                    <div class="info-row">
                        <span class="info-label"><i class="bi bi-calculator"></i> Стоимость</span>
                        <span class="info-value">
                            <span class="price-highlight">@Model.TotalPrice.ToString("N2") BYN</span>
                        </span>
                    </div>
                    
                    @if (Model.Car != null)
                    {
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-tag"></i> Цена за день</span>
                            <span class="info-value">@Model.Car.DailyPrice.ToString("N2") BYN</span>
                        </div>
                        
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-calculator"></i> Расчет</span>
                            <span class="info-value">
                                @Model.Car.DailyPrice.ToString("N2") BYN × @((Model.ReturnDate - Model.RentDate).Days) дней = 
                                <span class="price-highlight">@Model.TotalPrice.ToString("N2") BYN</span>
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Кнопки действий (не попадают в PDF) -->
            <div class="buttons-container">
                <button id="exportPdfBtn" class="btn btn-primary">
                    <i class="bi bi-file-earmark-pdf"></i> Чек в PDF
                </button>
                <a href="@Url.Action("MyBookings", "Profile")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Назад к списку
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <script>
        // Объявляем переменную с ID аренды
        var rentalId = @Model.Id;
        
        document.addEventListener('DOMContentLoaded', function() {
            const pdfButton = document.getElementById('exportPdfBtn');

            if (pdfButton) {
                pdfButton.addEventListener('click', async function() {
                    pdfButton.innerHTML = '<i class="bi bi-hourglass me-2"></i>Генерация PDF...';
                    pdfButton.disabled = true;

                    try {
                        await generatePdfFromHtml();
                    } catch (error) {
                        console.error('Ошибка:', error);
                        alert('Не удалось сгенерировать PDF. Пожалуйста, попробуйте позже.');
                    } finally {
                        pdfButton.innerHTML = '<i class="bi bi-file-earmark-pdf me-2"></i>Чек в PDF';
                        pdfButton.disabled = false;
                    }
                });
            }
        });

        async function generatePdfFromHtml() {
            const element = document.getElementById('pdfContent');
            
            if (!element) {
                alert('Не удалось найти данные для экспорта');
                return;
            }

            try {
                // Рендерим содержимое в canvas
                const canvas = await html2canvas(element, {
                    scale: 2,
                    backgroundColor: '#ffffff',
                    logging: false,
                    useCORS: true,
                    windowWidth: element.scrollWidth,
                    windowHeight: element.scrollHeight
                });
                
                const imgData = canvas.toDataURL('image/png');
                const { jsPDF } = window.jspdf;
                
                // Рассчитываем размеры для одной страницы
                const imgWidth = 190;
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                
                const doc = new jsPDF({
                    orientation: 'portrait',
                    unit: 'mm',
                    format: 'a4'
                });
                
                // Добавляем изображение на страницу
                doc.addImage(imgData, 'PNG', 10, 10, imgWidth, imgHeight);
                
                // Сохраняем PDF
                doc.save(`Аренда_${rentalId}_${new Date().toISOString().slice(0,10)}.pdf`);
                
            } catch (error) {
                console.error('Ошибка при создании PDF:', error);
                alert('Ошибка при создании PDF файла');
            }
        }
    </script>
}