@{
    ViewData["Title"] = "CarRental";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<style>
    /* Hero секция */
    .hero-section {
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }
    
    /* Контент с белой подложкой — уменьшенная высота */
    .hero-content {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 2rem 2rem;
        border-radius: 30px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    
    body.dark-mode .hero-content {
        background: rgba(30, 30, 35, 0.95);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }
    
    /* Анимированная иконка */
    .car-icon {
        font-size: 4rem;
        color: #3498db;
        animation: float 3s ease-in-out infinite;
        margin-bottom: 0.5rem;
    }
    
    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    
    /* Заголовок */
    .title {
        font-size: 3rem;
        font-weight: 800;
        background: linear-gradient(135deg, #2c3e50, #3498db);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }
    
    body.dark-mode .title {
        background: linear-gradient(135deg, #ecf0f1, #3498db);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .subtitle {
        font-size: 1rem;
        color: #6c757d;
        letter-spacing: 2px;
        margin-bottom: 1rem;
    }
    
    body.dark-mode .subtitle {
        color: #adb5bd;
    }
    
    /* Разделитель */
    .divider {
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, #3498db, #2c3e50);
        border-radius: 3px;
        margin: 0 auto 1rem auto;
    }
    
    body.dark-mode .divider {
        background: linear-gradient(90deg, #3498db, #ecf0f1);
    }
    
    /* Текст описания */
    .mission-text {
        font-size: 1rem;
        color: #2c3e50;
        max-width: 650px;
        margin: 0 auto 1.5rem auto;
        line-height: 1.5;
    }
    
    body.dark-mode .mission-text {
        color: #e0e0e0;
    }
    
    .mission-text strong {
        color: #3498db;
        font-weight: 700;
    }
    
    /* Кнопки */
    .btn-mode {
        padding: 0.7rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .btn-user {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
    }
    
    .btn-user:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(52, 152, 219, 0.4);
        color: white;
    }
    
    .btn-admin {
        background: linear-gradient(135deg, #2c3e50, #1a252f);
        color: white;
        box-shadow: 0 5px 15px rgba(44, 62, 80, 0.3);
    }
    
    .btn-admin:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(44, 62, 80, 0.4);
        color: white;
    }
    
    /* Бренды — только БЕЛДЖИ */
    .brands {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(0,0,0,0.1);
    }
    
    body.dark-mode .brands {
        border-top-color: rgba(255,255,255,0.1);
    }
    
    .brands-text {
        font-size: 0.75rem;
        color: #6c757d;
        letter-spacing: 1px;
        margin-bottom: 0.75rem;
    }
    
    body.dark-mode .brands-text {
        color: #adb5bd;
    }
    
    .brands-icons {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }
    
    .brands-icons span {
        font-size: 0.9rem;
        color: #6c757d;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(52, 152, 219, 0.1);
        padding: 0.4rem 1.2rem;
        border-radius: 30px;
    }
    
    body.dark-mode .brands-icons span {
        color: #adb5bd;
        background: rgba(52, 152, 219, 0.2);
    }
    
    .brands-icons i {
        font-size: 1.1rem;
        color: #3498db;
    }
    
    /* Флаг */
    .flag {
        margin-top: 1rem;
        font-size: 1.5rem;
        opacity: 1.0;
    }
    
    /* Адаптивность */
    @@media (max-width: 768px) {
        .hero-content {
            padding: 1.5rem 1rem;
        }
        
        .title {
            font-size: 2rem;
        }
        
        .subtitle {
            font-size: 0.85rem;
        }
        
        .mission-text {
            font-size: 0.85rem;
            margin-bottom: 1rem;
        }
        
        .car-icon {
            font-size: 3rem;
        }
        
        .btn-mode {
            padding: 0.5rem 1.2rem;
            font-size: 0.8rem;
            width: 100%;
            justify-content: center;
        }
        
        .brands-icons span {
            font-size: 0.8rem;
            padding: 0.3rem 0.8rem;
        }
        
        .hero-section {
            padding: 1.5rem 1rem;
        }
    }
</style>

<div class="hero-section">
    <div class="hero-content">
        <!-- Анимированная иконка -->
        <div class="car-icon">
            <i class="bi bi-car-front-fill"></i>
        </div>
        
        <!-- Заголовок -->
        <h1 class="title">CarRental</h1>
        <p class="subtitle">АРЕНДА АВТОМОБИЛЕЙ</p>
        
        <!-- Разделитель -->
        <div class="divider"></div>
        
        <!-- Текст миссии -->
        <p class="mission-text">
            <strong>CarRental</strong> — платформа для популяризации 
            <strong>белорусского машиностроения</strong>. 
            Выбирайте отечественные автомобили, поддерживайте родное производство 
            и наслаждайтесь качеством, проверенным временем.
        </p>
        
        <!-- Кнопки -->
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/User/Index" class="btn-user btn-mode">
                <i class="bi bi-person"></i> Режим пользователя
            </a>
            <a href="/Account/AdminRegister" class="btn-admin btn-mode">
                <i class="bi bi-shield-lock"></i> Режим администратора
            </a>
        </div>
        
        <!-- Блок с брендами — только БЕЛДЖИ -->
        <div class="brands">
            <p class="brands-text">ПОДДЕРЖИВАЕМ ОТЕЧЕСТВЕННОГО ПРОИЗВОДИТЕЛЯ</p>
            <div class="brands-icons">
                <span><i class="bi bi-car-front"></i> БЕЛДЖИ</span>
            </div>
        </div>
        
        <!-- Флаг -->
        <div class="flag">
            🇧🇾
        </div>
    </div>
</div>