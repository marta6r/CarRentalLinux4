                                <div class="form-group mb-3">
                                    <label class="form-label">
                                        <i class="bi bi-list-check"></i> @feature.Name
                                    </label>
                                    <select name="feature_@feature.Id" class="form-control">
                                        <option value="">-- Выберите @feature.Name.ToLower() --</option>
                                        @if (ViewBag.FeatureValues != null && ViewBag.FeatureValues.ContainsKey(feature.Id))
                                        {
                                            var values = ViewBag.FeatureValues[feature.Id] as List<CarRental.Models.FeatureValue>;
                                            if (values != null)
                                            {
                                                foreach (var value in values)
                                                {
                                                    var isSelected = selectedFeatureValues.ContainsKey(feature.Id) && selectedFeatureValues[feature.Id] == value.Id;
                                                    <option value="@value.Id" selected="@isSelected">@value.Value</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-secondary me-md-2">
                        <i class="bi bi-arrow-left"></i> Назад к списку
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Сохранить изменения
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}