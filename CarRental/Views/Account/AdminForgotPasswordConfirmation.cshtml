@{
    ViewData["Title"] = "Проверьте email";
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
}

<div class="container" style="max-width: 500px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <i class="bi bi-envelope-check" style="font-size: 4rem; color: #27ae60;"></i>
            </div>
            <h3>Проверьте вашу почту</h3>
            <p class="text-muted">@ViewBag.Message</p>
            
            @if (ViewBag.ShowLink == true && ViewBag.ResetLink != null)
            {
                var resetLink = ViewBag.ResetLink as string;
                <div class="alert alert-info mt-3">
                    <i class="bi bi-link"></i>
                    <a href="@resetLink" target="_blank" class="fw-bold">Перейти по ссылке для сброса пароля</a>
                </div>
                <div class="mt-2">
                    <small class="text-muted">Ссылка: <span style="word-break: break-all;">@resetLink</span></small>
                </div>
            }
            
            <a href="/Account/AdminLogin" class="btn btn-primary mt-3">
                <i class="bi bi-arrow-left"></i> Вернуться ко входу
            </a>
        </div>
    </div>
</div>

<style>
    .card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
    }
    
    body.dark-mode .card {
        background: rgba(45, 45, 45, 0.95);
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        border: none;
        font-weight: 600;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(231, 76, 60, 0.4);
    }
</style>